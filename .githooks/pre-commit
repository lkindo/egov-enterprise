#!/bin/sh
# eGov Enterprise — pre-commit (계약/타입 드리프트 경고, 빠름·오프라인)
# 우회: git commit --no-verify   |   비활성화: git config --unset core.hooksPath
# 참고: 드리프트는 '경고'만 한다(BLOCK 아님) — api-docs.json 자체가 stale일 수 있어 오탐을 피한다.
[ -n "$SKIP_HOOKS" ] && exit 0

# [보안] 시크릿 스캔 — gitleaks 설치 시에만 동작(미설치 환경 무해). 스테이징된 변경에 한정.
# 탐지 시 커밋 BLOCK. 오탐이면 .gitleaksignore 등록 또는 우회: git commit --no-verify
if command -v gitleaks >/dev/null 2>&1; then
  if ! gitleaks protect --staged --no-banner >/dev/null 2>&1; then
    echo "⛔ [pre-commit] gitleaks가 스테이징 변경에서 잠재적 시크릿을 탐지했습니다. 커밋 중단."
    echo "   확인: gitleaks protect --staged --verbose"
    exit 1
  fi
else
  # [W0-08] 종전에는 미설치 시 **아무 출력 없이** 통과했다. 그 침묵이 '스캔이 돌았다'는
  #   거짓 안전감을 만든다(GEMINI.md §0.7-H5: 실행되지 않는 게이트는 없는 게이트).
  #   훅에서 hard-fail 로 바꾸지는 않는다 — 로컬 미설치가 커밋을 전면 차단하면 --no-verify 상시화를
  #   유발하기 때문이다. 차단 책임은 CI 의 secret-scan 잡에 둔다(스캔 범위도 그쪽이 넓다: 히스토리 전체).
  echo "⚠  [pre-commit] gitleaks 미설치 — 로컬 시크릿 스캔을 건너뜁니다 (설치: winget install gitleaks)."
  echo "   최종 관문은 CI 의 secret-scan 잡입니다. 로컬 통과가 CI 통과를 보장하지 않습니다."
fi

STAGED=$(git diff --cached --name-only)
if echo "$STAGED" | grep -qE '(api-docs\.json|Dto\.java|Controller\.java|src/types/generated-)'; then
  if command -v pnpm >/dev/null 2>&1; then
    echo "[pre-commit] API 계약 드리프트 점검 (codegen:verify)…"
    pnpm -C frontend run codegen:verify >/dev/null 2>&1 \
      || echo "⚠  generated-api.d.ts 드리프트 가능 — 'pnpm -C frontend codegen:file' 후 스테이징 (GEMINI.md §4). 원인이 stale api-docs.json인지 먼저 확인."
    pnpm -C frontend run codegen:verify:zod >/dev/null 2>&1 \
      || echo "⚠  generated-zod.ts 드리프트 가능 — 'pnpm -C frontend codegen:zod' 후 스테이징."
  fi
fi
exit 0
