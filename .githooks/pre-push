#!/bin/sh
# eGov Enterprise — AGENTS.md 범위별 검증을 구현하는 로컬 pre-push 게이트
# 우회: git push --no-verify   |   비활성화: git config --unset core.hooksPath
[ -n "$SKIP_HOOKS" ] && exit 0
set -e

# stdin의 모든 push ref 범위를 합쳐 변경 파일을 과소 추정하지 않는다.
RANGES=""
while read local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    RANGES="$RANGES origin/main..$local_sha"
  else
    RANGES="$RANGES $remote_sha..$local_sha"
  fi
done

# IDE/GUI처럼 stdin 범위가 없는 경우 upstream 또는 origin/main 전체 차이를 사용한다.
# 불확실하면 fast-pass를 포기하는 방향으로만 폴백한다.
if [ -z "$RANGES" ]; then
  UPSTREAM=$(git rev-parse --abbrev-ref --symbolic-full-name @{u} 2>/dev/null || true)
  if [ -n "$UPSTREAM" ]; then
    RANGES="$UPSTREAM..HEAD"
  elif git rev-parse --verify -q origin/main >/dev/null 2>&1; then
    # 업스트림이 없는 신규 브랜치의 첫 푸시. origin/main 과의 차이는 이 브랜치가 더한 것을 전부 포함한다.
    RANGES="origin/main..HEAD"
  fi
fi

# 범위를 특정하지 못하면 fast-pass하지 않는다.
CHANGED_FILES=""
if [ -n "$RANGES" ]; then
  # --no-renames makes a cross-scope rename visible as delete+add. Otherwise
  # api-server/Foo.java -> docs/Foo.md exposes only the new documentation path
  # and can incorrectly qualify for the fast path.
  CHANGED_FILES=$(for r in $RANGES; do git diff --no-renames --name-only --diff-filter=ACMRD $r 2>/dev/null; done | sort -u)
else
  echo "[pre-push] ℹ 푸시 범위를 특정하지 못했습니다 — fast-pass 없이 전체 게이트를 실행합니다(안전측)."
fi

# Git은 hook 프로세스에 GIT_DIR/GIT_WORK_TREE 등의 저장소 로컬 환경을
# 주입한다. 이를 하위 npm/pnpm/git 검사에 그대로 넘기면 별도 worktree나
# 테스트용 임시 저장소가 현재 push 저장소로 오인될 수 있다. 변경 범위를
# 계산한 뒤 Git이 공식적으로 열거한 로컬 변수만 제거하고 cwd 기반으로
# 현재 worktree를 다시 발견하게 한다.
GIT_LOCAL_ENV_VARS=$(git rev-parse --local-env-vars)
for GIT_LOCAL_ENV_VAR in $GIT_LOCAL_ENV_VARS; do
  unset "$GIT_LOCAL_ENV_VAR"
done
unset GIT_LOCAL_ENV_VARS GIT_LOCAL_ENV_VAR

# Node 기반 운영 계약은 하나의 catalog runner가 소유한다. 새 *.test.mjs를 추가하면
# 별도 훅 편집 없이 자동 편입되며, 문서-only fast-pass도 이 싼 계약을 통과한 뒤 종료한다.
echo "  → governance: npm run test:operational-contracts"
npm run test:operational-contracts \
  || { echo "❌ 운영 계약 실패 — 하네스 registry, CI scope, 문서·메모리 또는 실행 경로가 불일치합니다"; exit 1; }

# CI와 동일한 fail-closed 분류기를 fast-pass 판정에도 사용한다. 확장자만
# 보는 별도 allowlist를 두면 헌법 Markdown, 실행 가능한 docs 파일, rename의
# 이전 경로가 CI와 로컬에서 서로 다르게 분류될 수 있다.
SCOPE_DOCS_ONLY=$(printf '%s\n' "$CHANGED_FILES" | node scripts/ci-change-scope.mjs --stdin --field docsOnly)
SCOPE_BACKEND=$(printf '%s\n' "$CHANGED_FILES" | node scripts/ci-change-scope.mjs --stdin --field backend)
SCOPE_FRONTEND=$(printf '%s\n' "$CHANGED_FILES" | node scripts/ci-change-scope.mjs --stdin --field frontend)
echo "  → scope: docsOnly=$SCOPE_DOCS_ONLY / backend=$SCOPE_BACKEND / frontend=$SCOPE_FRONTEND"

if [ -n "$CHANGED_FILES" ]; then
  # Atlas는 전용 docs-as-code 계약을 통과한 경우에만 문서 fast-pass를 허용한다.
  if echo "$CHANGED_FILES" | grep -qx 'frontend/public/governance_harness_atlas.html'; then
    echo "  → atlas: pnpm -C frontend exec vitest run src/__tests__/cross-stack/governance-atlas-contract.test.ts"
    pnpm -C frontend exec vitest run src/__tests__/cross-stack/governance-atlas-contract.test.ts \
      || { echo "❌ Governance Atlas 계약 실패 — 현행 코드·모듈·접근성 계약과 불일치합니다"; exit 1; }
  fi

  if [ "$SCOPE_DOCS_ONLY" = "true" ]; then
    echo "[pre-push] 📝 문서/비코드 변경만 감지됨 — 컴파일 및 하네스 검증 생략 (Fast-pass)"
    echo "  → 변경 파일:"
    echo "$CHANGED_FILES" | sed 's/^/     - /'
    exit 0
  fi
fi

echo "[pre-push] AGENTS.md change-scoped source verification"

if [ "$SCOPE_BACKEND" = "true" ]; then
  echo "  → backend: ./gradlew compileJava compileTestJava"
  ./gradlew compileJava compileTestJava -q \
    || { echo "❌ Java 컴파일 실패 — 빌드 에러 0건 이후에만 push 허용 (AGENTS.md Verification)"; exit 1; }
else
  echo "  → backend: 변경 영향 없음 — Java compile/harness 생략"
fi

if [ "$SCOPE_FRONTEND" = "true" ] && [ -f frontend/package.json ]; then
  echo "  → frontend: npx tsc --noEmit"
  ( cd frontend && npx tsc --noEmit ) \
    || { echo "❌ TypeScript 타입 컴파일 실패 (AGENTS.md Verification)"; exit 1; }

  # 루트 tsconfig가 제외하는 E2E 스펙·fixture·POM을 별도 구성으로 검사한다.
  echo "  → frontend: npx tsc -p tsconfig.e2e.json --noEmit (E2E 스펙·POM)"
  ( cd frontend && npx tsc -p tsconfig.e2e.json --noEmit ) \
    || { echo "❌ E2E TypeScript 타입 검사 실패 — 루트 tsconfig 는 e2e 를 exclude 하므로 이 게이트가 유일 관문입니다."; exit 1; }

  # ESLint error는 계약 위반으로 차단하고 warning은 package.json 래칫으로 관리한다.
  echo "  → frontend: pnpm run lint (error 만 차단 — warning 은 통과)"
  ( cd frontend && pnpm run lint ) \
    || { echo "❌ ESLint 에러 — 경고는 package.json 래칫 범위에서 통과하지만 error는 수정해야 합니다."; exit 1; }

  echo "  → frontend: pnpm run test:form-validation (폼 경계·validation 증거 census)"
  ( cd frontend && pnpm run test:form-validation ) \
    || { echo "❌ 폼 validation census 실패 — 신규/누락 경계를 분류하고 비준수 화면의 검증·오류 이동·서버 오류·pending 증거를 보완하세요."; exit 1; }

  # 빠른 저장소 불변식만 pre-push에서 실행하고 전수 Vitest/coverage는 CI가 소유한다.
  echo "  → frontend: vitest src/__tests__ (저장소 불변식 게이트)"
  ( cd frontend && npx vitest run src/__tests__ ) \
    || { echo "❌ 프런트 불변식 게이트 실패 — 위반을 수정하고 하향 래칫의 개선분은 정본에 반영하세요."; exit 1; }

  # [계약 드리프트 게이트] api-docs.json ↔ generated-api.d.ts/generated-zod.ts 정합.
  # CI(ci.yml)에도 있으며, 로컬 pre-push에서는 빠른 드리프트 피드백을 위해 같은 계약을 선제 검사한다.
  # 커밋된 api-docs.json 기반(오프라인·결정적)이라 백엔드 재빌드 불요.
  # 언트랙 파일은 git diff에 잡히지 않으므로 계약 SSOT의 추적 상태를 먼저 확인한다.
  git ls-files --error-unmatch api-docs.json >/dev/null 2>&1 \
    || { echo "❌ api-docs.json 이 git 에 추적되지 않습니다 — 계약 드리프트 게이트가 vacuous 통과합니다"; exit 1; }

  echo "  → frontend: codegen drift gate (api-docs.json ↔ generated types/zod)"
  ( cd frontend && pnpm run codegen:verify && pnpm run codegen:verify:zod ) \
    || { echo "❌ codegen 드리프트 — api-docs.json 과 generated-api.d.ts/generated-zod.ts 불일치. 'pnpm -C frontend codegen:file && pnpm -C frontend codegen:zod' 로 재생성 후 커밋하세요 (계약 드리프트 방어)"; exit 1; }
fi

# 크로스 스택 계약(frontend/src/__tests__/cross-stack)은 백엔드 소스를 함께 감사한다.
# 프런트 게이트가 생략되는 백엔드-only push 에서도 이 하위 집합은 실행해야
# "감사 대상만 고치면 감사자가 돌지 않는" 경로가 생기지 않는다(H5).
if [ "$SCOPE_BACKEND" = "true" ] && [ "$SCOPE_FRONTEND" != "true" ] && [ -f frontend/package.json ]; then
  echo "  → cross-stack: vitest src/__tests__/cross-stack (frontend↔backend 진실 결속)"
  ( cd frontend && npx vitest run src/__tests__/cross-stack ) \
    || { echo "❌ 크로스 스택 계약 실패 — 백엔드 변경이 프런트 화면의 고지·문구 계약과 어긋납니다"; exit 1; }
fi

# 헌법·표준 governance 하네스. 로컬은 우회 가능하며 authoritative merge gate는 CI다.
# 우회: SKIP_HARNESS=1 git push
if [ "$SCOPE_BACKEND" = "true" ]; then
  if [ -z "$SKIP_HARNESS" ]; then
    echo "  → harness: ./gradlew :api-server:harnessTest"
    ./gradlew :api-server:harnessTest -q \
      || { echo "❌ 하네스 게이트 실패 — 헌법/표준 린터 위반. 리포트: api-server/build/reports/tests/harnessTest/index.html"; echo "   ⚠ 목록(동결·예외)을 고쳐 신호를 지우는 것은 수정이 아니라 은폐다 (AGENTS.md Evidence guardrails H2)"; exit 1; }
  else
    echo "  ⚠ harness 게이트 건너뜀(SKIP_HARNESS) — CI 또는 로컬에서 별도 실행 필요"
  fi
fi

echo "[pre-push] ✅ 변경 영향 범위의 컴파일·계약·하네스 게이트 통과"
