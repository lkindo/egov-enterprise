#!/bin/sh
# eGov Enterprise — pre-push = GEMINI.md §0.6 컴파일 무결성 게이트 (HARD, 차단)
# 우회: git push --no-verify   |   비활성화: git config --unset core.hooksPath
[ -n "$SKIP_HOOKS" ] && exit 0
set -e

echo "[pre-push] §0.6 Compilation Integrity Gate"

echo "  → backend: ./gradlew compileJava compileTestJava"
./gradlew compileJava compileTestJava -q \
  || { echo "❌ Java 컴파일 실패 — 빌드 에러 0건 이후에만 push 허용 (GEMINI.md §0.6)"; exit 1; }

if [ -f frontend/package.json ]; then
  echo "  → frontend: npx tsc --noEmit"
  ( cd frontend && npx tsc --noEmit ) \
    || { echo "❌ TypeScript 타입 컴파일 실패 (GEMINI.md §0.6)"; exit 1; }

  # [계약 드리프트 게이트] api-docs.json ↔ generated-api.d.ts/generated-zod.ts 정합.
  # CI(ci.yml)에도 있으나 CI 과금차단 상태라 로컬 pre-push 가 사실상 유일 관문 → 여기서도 강제.
  # 커밋된 api-docs.json 기반(오프라인·결정적)이라 백엔드 재빌드 불요.
  echo "  → frontend: codegen drift gate (api-docs.json ↔ generated types/zod)"
  ( cd frontend && pnpm run codegen:verify && pnpm run codegen:verify:zod ) \
    || { echo "❌ codegen 드리프트 — api-docs.json 과 generated-api.d.ts/generated-zod.ts 불일치. 'pnpm -C frontend codegen:file && pnpm -C frontend codegen:zod' 로 재생성 후 커밋하세요 (계약 드리프트 방어)"; exit 1; }
fi

echo "[pre-push] ✅ 컴파일 + 계약 게이트 통과"
