#!/bin/sh
# eGov Enterprise — pre-push = GEMINI.md §0.6 컴파일 무결성 게이트 (HARD, 차단)
# 우회: git push --no-verify   |   비활성화: git config --unset core.hooksPath
[ -n "$SKIP_HOOKS" ] && exit 0
set -e

# [스마트 Fast-pass] 문서/비코드 파일만 변경된 푸시는 컴파일 및 하네스 검증 생략
# stdin으로 들어오는 푸시 대상 범위(local_sha, remote_sha) 추출
#
# [W0-15] 다중 ref 푸시 취급 수정: 종전에는 while 루프가 매 반복마다 RANGE 를 덮어써
#   `git push --all` 이나 `git push origin a b` 시 **마지막 ref 하나만** 평가됐다.
#   앞선 ref 의 변경분이 fast-pass 판정에서 통째로 누락되어 게이트를 건너뛸 수 있었다.
RANGES=""
while read local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    RANGES="$RANGES origin/main..$local_sha"
  else
    RANGES="$RANGES $remote_sha..$local_sha"
  fi
done

# [2026-08-04] stdin 으로 범위가 안 오는 호출 형태(IDE/GUI 푸시 등)가 있어 폴백을 둔다.
#   폴백이 없으면 **문서 한 줄 푸시에도 전체 하네스(~2분)가 돌아** fast-pass 가 사실상 죽는다.
#
#   ⚠ 폴백의 유일한 규칙: **과대추정은 되어도 과소추정은 안 된다.**
#      과대추정하면 fast-pass 를 놓쳐 느려질 뿐이지만(비용), 과소추정하면 코드 변경이 게이트를
#      건너뛴다(사고). 아래 두 폴백은 모두 `X..HEAD` 형태의 트리 비교라 실제 푸시분을 덮거나 넘는다.
if [ -z "$RANGES" ]; then
  UPSTREAM=$(git rev-parse --abbrev-ref --symbolic-full-name @{u} 2>/dev/null || true)
  if [ -n "$UPSTREAM" ]; then
    RANGES="$UPSTREAM..HEAD"
  elif git rev-parse --verify -q origin/main >/dev/null 2>&1; then
    # 업스트림이 없는 신규 브랜치의 첫 푸시. origin/main 과의 차이는 이 브랜치가 더한 것을 전부 포함한다.
    RANGES="origin/main..HEAD"
  fi
fi

# [2026-08-04 안전측 정정] 범위를 특정하지 못하면 **fast-pass 하지 않는다**.
#
#   종전 폴백에는 `HEAD~1..HEAD` 가 있었다. 그것은 **마지막 커밋 하나만** 보는 것이라,
#   여러 커밋을 한 번에 푸시하면 앞선 커밋의 코드 변경이 판정에서 통째로 누락된다 —
#   마지막 커밋이 문서면 그 푸시 전체가 fast-pass 된다(과소추정).
#   하필 그 구멍으로 나갈 수 있는 대표적 편집이 **이 훅 파일 자신**이다(매니페스트 헤더가 경고하는
#   '편집된 훅이 자기 자신의 푸시를 승인' 하는 형태).
#   fast-pass 는 '확실히 문서만' 일 때의 최적화이지 '모르겠을 때' 의 기본값이 아니다.
CHANGED_FILES=""
if [ -n "$RANGES" ]; then
  CHANGED_FILES=$(for r in $RANGES; do git diff --name-only $r 2>/dev/null; done | sort -u)
else
  echo "[pre-push] ℹ 푸시 범위를 특정하지 못했습니다 — fast-pass 없이 전체 게이트를 실행합니다(안전측)."
fi

if [ -n "$CHANGED_FILES" ]; then
  # [W0-15] allowlist → denylist 반전.
  #   종전 정규식은 '코드로 인정할 확장자'를 열거했다. 그 결과 확장자가 없거나 목록에 없는 파일이
  #   전부 fast-pass 되었고, 하필 그 집합이 **게이트를 무력화할 수 있는 파일들**이었다:
  #     .githooks/pre-push(이 파일 자신) · .githooks/pre-commit ·
  #     api-server/src/test/resources/harness/baseline-manifest.properties(동결 기준) ·
  #     gradle/libs.versions.toml(버전 카탈로그) · gradle/wrapper/gradle-wrapper.properties(툴체인 URL) ·
  #     gradlew / gradlew.bat · api-server/Dockerfile · frontend/Dockerfile ·
  #     scripts/*.mjs · scripts/*.ps1 · scripts/*.sh · *.properties · *.css
  #   즉 '게이트를 끄는 편집'이 게이트를 통과했다 (GEMINI.md §0.7-H5).
  #   (참고: `^Dockerfile` 은 행 시작 앵커라 하위 경로 Dockerfile 을 하나도 매칭하지 못하는 死조건이었다.)
  #   이제는 '확실히 비코드'인 확장자만 fast-pass 하고 나머지는 전부 코드로 간주한다(안전측 기본값).
  CODE_CHANGES=$(echo "$CHANGED_FILES" | grep -vE '\.(md|mdx|txt|csv|png|jpe?g|gif|svg|webp|ico|pdf|woff2?|ttf|eot|mp4|webm)$' || true)
  if [ -z "$CODE_CHANGES" ]; then
    echo "[pre-push] 📝 문서/비코드 변경만 감지됨 — 컴파일 및 하네스 검증 생략 (Fast-pass)"
    echo "  → 변경 파일:"
    echo "$CHANGED_FILES" | sed 's/^/     - /'
    exit 0
  fi
fi

echo "[pre-push] §0.6 Compilation Integrity Gate"

echo "  → reusable base profile: node --test scripts/reusable-base-census.test.mjs"
node --test scripts/reusable-base-census.test.mjs \
  || { echo "❌ reusable base 프로필 계약 실패 — 도메인/테이블 소유권 또는 pack 의존 방향 위반"; exit 1; }

# 문서 링크 무결성(수 초). 코드가 이동·삭제돼도 문서 링크는 조용히 남아 다음 사람을 오도한다 —
# 2026-08-16 실측에서 자체 문서에 팬텀 링크 17건(소멸 모듈 business-suite·이동된 JwtTokenProvider 등)이 있었다.
echo "  → docs: node --test scripts/docs-link-integrity.test.mjs"
node --test scripts/docs-link-integrity.test.mjs \
  || { echo "❌ 문서 링크 무결성 실패 — 존재하지 않는 대상을 가리키는 링크가 있습니다"; exit 1; }

echo "  → backend: ./gradlew compileJava compileTestJava"
./gradlew compileJava compileTestJava -q \
  || { echo "❌ Java 컴파일 실패 — 빌드 에러 0건 이후에만 push 허용 (GEMINI.md §0.6)"; exit 1; }

if [ -f frontend/package.json ]; then
  echo "  → frontend: npx tsc --noEmit"
  ( cd frontend && npx tsc --noEmit ) \
    || { echo "❌ TypeScript 타입 컴파일 실패 (GEMINI.md §0.6)"; exit 1; }

  # [2026-08-10 신설] E2E 전용 타입 게이트.
  #
  #   위의 `tsc --noEmit` 은 frontend/tsconfig.json 을 쓰는데, 그 exclude 에 `"e2e"` 가 들어 있다.
  #   즉 **E2E 스펙(26개 파일·POM 24개)은 지금까지 어떤 게이트에도 타입 검사를 받은 적이 없다.**
  #   Playwright 러너도 타입을 검사하지 않고 벗겨내기만 하므로(transpile-only), E2E 의 타입 오류는
  #   CI 의 4분짜리 e2e 잡이 실패해야만 드러났다.
  #
  #   실증(2026-08-10, 이 게이트를 처음 돌린 결과): 죽은 선언 3건이 즉시 검출됐다 —
  #     SurveyPage.selectDate(호출부 0) · SurveyPage.ensurePopoverClosed(호출부 0) ·
  #     05-public-experience 의 미사용 지역변수. 아무도 모르는 채 남아 있던 것들이다.
  #   위반 주입으로 red 가 되는 것도 확인했다(TS2322/TS2339 → exit 2).
  echo "  → frontend: npx tsc -p tsconfig.e2e.json --noEmit (E2E 스펙·POM)"
  ( cd frontend && npx tsc -p tsconfig.e2e.json --noEmit ) \
    || { echo "❌ E2E TypeScript 타입 검사 실패 — 루트 tsconfig 는 e2e 를 exclude 하므로 이 게이트가 유일 관문입니다."; exit 1; }

  # [2026-08-04 신설] ESLint — 이 훅에 없어서 실제로 뚫린 구멍이다.
  #
  #   2026-08-03 실측: `useAppForm.test.tsx` 의 인라인 z.object 1건이 lint 에러였는데
  #   pre-push 가 eslint 를 돌지 않아 그대로 push 됐다. 그 결과 CI 의 frontend-build 가 죽었고,
  #   e2e-tests 는 frontend-build 에 needs 로 매달려 있어 **22티어가 통째로 skip** 됐다.
  #   즉 lint 에러 1건이 E2E 전체를 재우고 있었고, 그 상태가 여러 커밋에 걸쳐 유지됐다.
  #
  #   tsc 가 통과해도 lint 는 떨어질 수 있다 — 이 저장소의 lint 는 타입 검사가 아니라
  #   **계약 규칙**(예: 인라인 z.object 금지 = 백엔드 생성 스키마 SSOT 강제)을 담고 있어서
  #   tsc 로는 원리적으로 대체되지 않는다.
  #
  #   ⚠ 경고는 차단하지 않는다. 현행 457건은 점진 정리 대상이고(react-hooks 계열 등),
  #   경고까지 막으면 게이트가 오탐 지배가 되어 SKIP 사용을 정당화한다. 막는 것은 error 뿐이다.
  echo "  → frontend: pnpm run lint (error 만 차단 — warning 은 통과)"
  ( cd frontend && pnpm run lint ) \
    || { echo "❌ ESLint 에러 — CI frontend-build 가 죽고 e2e 전체가 skip 됩니다(2026-08-03 실측)."; \
         echo "   경고(warning)는 차단 대상이 아닙니다. 위 출력에서 'error' 로 표시된 항목만 고치면 됩니다."; exit 1; }

  # [2026-08-11 신설] 프런트 **저장소 불변식 게이트**(frontend/src/__tests__).
  #
  #   여기가 비어 있어서 실제로 한 회차를 통째로 날렸다(2026-08-10, CI run 31369018355):
  #   blind-wait 하향 래칫 1건이 red 였는데 pre-push 는 vitest 를 돌지 않아 그대로 push 됐고,
  #   CI 의 `e2e-tests` 는 `needs: [backend-build, frontend-build]` 라 **E2E 3샤드가 통째로 skip**
  #   됐다. 즉 정작 검증하려던 것이 한 번도 실행되지 않았다(2026-08-03 lint 사고와 동일 구조).
  #
  #   전수(64파일·337건)는 로컬 실측 약 147초라 이 훅의 예산에 맞지 않는다. 그래서 **규약을
  #   인코딩한 게이트만** 돌린다 — src/__tests__ 5파일·18건, 실측 10초:
  #     e2e-blind-wait-ratchet · fe-auth-hardening · middleware ·
  #     form-action-confirm-deadlock-guard · hardcoded-color-guard
  #   전수는 `./gradlew localGate` 계층이 소유한다(frontendUnitTest 태스크).
  echo "  → frontend: vitest src/__tests__ (저장소 불변식 게이트)"
  ( cd frontend && npx vitest run src/__tests__ ) \
    || { echo "❌ 프런트 불변식 게이트 실패 — 이 상태로 push 하면 CI frontend-build 가 죽고"; \
         echo "   e2e-tests 3샤드가 통째로 skip 됩니다(2026-08-10 실측: run 31369018355)."; \
         echo "   💡 하향 래칫(예: blind wait)이면 개선분을 BASELINE 에 확정해야 통과합니다."; exit 1; }

  # [계약 드리프트 게이트] api-docs.json ↔ generated-api.d.ts/generated-zod.ts 정합.
  # CI(ci.yml)에도 있으나 CI 과금차단 상태라 로컬 pre-push 가 사실상 유일 관문 → 여기서도 강제.
  # 커밋된 api-docs.json 기반(오프라인·결정적)이라 백엔드 재빌드 불요.
  # [W0-12] 계약 SSOT 가 git 에 추적되고 있는지 먼저 확인한다.
  #   codegen:verify 는 `git diff --exit-code <path>` 로 판정하는데, 대상이 **언트랙이면 diff 가
  #   무조건 exit 0** 이라 게이트가 조용히 vacuous 통과한다. 파일이 아예 없으면 loud fail 이므로
  #   위험 구간은 정확히 '디스크에는 있으나 언트랙' 하나다.
  git ls-files --error-unmatch api-docs.json >/dev/null 2>&1 \
    || { echo "❌ api-docs.json 이 git 에 추적되지 않습니다 — 계약 드리프트 게이트가 vacuous 통과합니다"; exit 1; }

  echo "  → frontend: codegen drift gate (api-docs.json ↔ generated types/zod)"
  ( cd frontend && pnpm run codegen:verify && pnpm run codegen:verify:zod ) \
    || { echo "❌ codegen 드리프트 — api-docs.json 과 generated-api.d.ts/generated-zod.ts 불일치. 'pnpm -C frontend codegen:file && pnpm -C frontend codegen:zod' 로 재생성 후 커밋하세요 (계약 드리프트 방어)"; exit 1; }
fi

# [하네스 게이트] 헌법/표준 린터를 실제로 실행한다.
# 이 단계가 없던 동안 하네스 린터(PK 채번 표준·인가 애노테이션·동결 목록 무결성 등)는 CI(과금차단)에만
# 걸려 있어 사실상 어디서도 실행되지 않았다 — 2026-07-26 감사에서 "게이트가 있는데 돌지 않는" 상태로 확인.
# 린터를 새로 다는 것보다 '돌게 만드는 것'이 우선이라 pre-push 로 승격한다.
# 우회: SKIP_HARNESS=1 git push  (Spring 컨텍스트 기동 포함이라 1~2분 소요)
if [ -z "$SKIP_HARNESS" ]; then
  echo "  → harness: ./gradlew :api-server:harnessTest (약 2분 — 실측 1m58s)"
  ./gradlew :api-server:harnessTest -q \
    || { echo "❌ 하네스 게이트 실패 — 헌법/표준 린터 위반. 리포트: api-server/build/reports/tests/test/index.html"; echo "   ⚠ 목록(동결·예외)을 고쳐 신호를 지우는 것은 수정이 아니라 은폐다 (GEMINI.md §0.7-H2)"; exit 1; }
else
  echo "  ⚠ harness 게이트 건너뜀(SKIP_HARNESS) — CI 또는 로컬에서 별도 실행 필요"
fi

echo "[pre-push] ✅ 컴파일 + 계약 + 하네스 게이트 통과"
