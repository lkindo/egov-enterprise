#!/bin/sh
# eGov Enterprise — AGENTS.md 범위별 검증을 구현하는 로컬 pre-push 게이트
# 우회: git push --no-verify   |   비활성화: git config --unset core.hooksPath
# 검사 범위는 push 범위(stdin 의 remote_sha..local_sha)로 고르지만, 모든 검사는 push 하는 커밋이 아니라 현재
# 체크아웃(index·작업 트리)에서 돈다. 다른 브랜치를 push 하거나 커밋하지 않은 변경이 있으면 로컬 결과는 그 커밋의
# 증거가 아니다 — 그 커밋의 권위는 required CI 다.
[ -n "$SKIP_HOOKS" ] && exit 0
set -e

# stdin의 모든 object-bearing push ref 범위를 합쳐 변경 파일을 과소 추정하지 않는다.
# remote ref 삭제는 local object를 전송하지 않으므로 변경 범위에서 제외한다.
ZERO_OID="0000000000000000000000000000000000000000"
DELETION_REFS=0
OBJECT_REFS=0
RANGES=""
while read local_ref local_sha remote_ref remote_sha; do
  if [ "$local_sha" = "$ZERO_OID" ]; then
    DELETION_REFS=$((DELETION_REFS + 1))
    continue
  fi

  OBJECT_REFS=$((OBJECT_REFS + 1))
  if [ "$remote_sha" = "$ZERO_OID" ]; then
    RANGES="$RANGES origin/main..$local_sha"
  else
    RANGES="$RANGES $remote_sha..$local_sha"
  fi
done

if [ "$DELETION_REFS" -gt 0 ] && [ "$OBJECT_REFS" -eq 0 ]; then
  echo "[pre-push] remote branch/tag 삭제만 감지됨 — 전송할 object가 없어 로컬 검증을 생략합니다."
  exit 0
fi

# IDE/GUI처럼 stdin 범위가 없는 경우 upstream 또는 origin/main 전체 차이를 사용한다.
# 불확실하면 fast-pass를 포기하는 방향으로만 폴백한다.
if [ -z "$RANGES" ]; then
  UPSTREAM=$(git rev-parse --abbrev-ref --symbolic-full-name @{u} 2>/dev/null || true)
  if [ -n "$UPSTREAM" ]; then
    RANGES="$UPSTREAM..HEAD"
  elif git rev-parse --verify -q origin/main >/dev/null 2>&1; then
    # 업스트림이 없는 신규 브랜치의 첫 푸시. origin/main 과의 차이는 이 브랜치가 더한 것을 전부 포함한다.
    RANGES="origin/main..HEAD"
  fi
fi

# 범위를 특정하지 못하면 fast-pass하지 않는다.
CHANGED_FILES=""
if [ -n "$RANGES" ]; then
  # --no-renames makes a cross-scope rename visible as delete+add. Otherwise
  # api-server/Foo.java -> docs/Foo.md exposes only the new documentation path
  # and can incorrectly qualify for the fast path.
  # 각 ref를 따로 확인한다. pipeline의 sort 성공이 앞선 diff 실패를 숨기면
  # 일부 문서 경로만으로 fast-pass할 수 있으므로, 하나라도 실패하면 목록 전체를 버린다.
  for r in $RANGES; do
    if RANGE_FILES=$(git diff --no-renames --name-only --diff-filter=ACMRD "$r" 2>/dev/null); then
      if [ -n "$RANGE_FILES" ]; then
        CHANGED_FILES="${CHANGED_FILES:+$CHANGED_FILES
}$RANGE_FILES"
      fi
    else
      echo "[pre-push] ℹ 변경 범위를 읽지 못했습니다 — 부분 목록을 버리고 전체 게이트를 실행합니다(안전측)." >&2
      CHANGED_FILES=""
      break
    fi
  done
  CHANGED_FILES=$(printf '%s\n' "$CHANGED_FILES" | sort -u)
else
  echo "[pre-push] ℹ 푸시 범위를 특정하지 못했습니다 — fast-pass 없이 전체 게이트를 실행합니다(안전측)."
fi

# Git은 hook 프로세스에 GIT_DIR/GIT_WORK_TREE 등의 저장소 로컬 환경을
# 주입한다. 이를 하위 npm/pnpm/git 검사에 그대로 넘기면 별도 worktree나
# 테스트용 임시 저장소가 현재 push 저장소로 오인될 수 있다. 변경 범위를
# 계산한 뒤 Git이 공식적으로 열거한 로컬 변수만 제거하고 cwd 기반으로
# 현재 worktree를 다시 발견하게 한다.
GIT_LOCAL_ENV_VARS=$(git rev-parse --local-env-vars)
for GIT_LOCAL_ENV_VAR in $GIT_LOCAL_ENV_VARS; do
  unset "$GIT_LOCAL_ENV_VAR"
done
unset GIT_LOCAL_ENV_VARS GIT_LOCAL_ENV_VAR

# CI와 동일한 fail-closed 분류기를 fast-pass 판정에도 사용한다. 확장자만
# 보는 별도 allowlist를 두면 헌법 Markdown, 실행 가능한 docs 파일, rename의
# 이전 경로가 CI와 로컬에서 서로 다르게 분류될 수 있다.
SCOPE_DOCS_ONLY=$(printf '%s\n' "$CHANGED_FILES" | node scripts/ci-change-scope.mjs --stdin --field docsOnly)
SCOPE_BACKEND=$(printf '%s\n' "$CHANGED_FILES" | node scripts/ci-change-scope.mjs --stdin --field backend)
SCOPE_MIGRATION=$(printf '%s\n' "$CHANGED_FILES" | node scripts/ci-change-scope.mjs --stdin --field migration)
SCOPE_FRONTEND=$(printf '%s\n' "$CHANGED_FILES" | node scripts/ci-change-scope.mjs --stdin --field frontend)
SCOPE_ATLAS=$(printf '%s\n' "$CHANGED_FILES" | node scripts/ci-change-scope.mjs --stdin --field atlas)
echo "  → scope: docsOnly=$SCOPE_DOCS_ONLY / backend=$SCOPE_BACKEND / migration=$SCOPE_MIGRATION / frontend=$SCOPE_FRONTEND"

# 관측 전용 기록: 명령/인자/환경/출력은 저장하지 않는다. 기록 실패는 검사 결과를 바꾸지 않는다.
# 삭제-only는 위에서 끝난다. 아직 실행되지 않은 단계는 성공으로 추정하지 않는다.
RECORD_ROOT=$(pwd)
RECORD_SCRIPT="$RECORD_ROOT/scripts/verification-record.mjs"
RECORD_SCOPE=source
[ "$SCOPE_DOCS_ONLY" = "true" ] && RECORD_SCOPE=docs
# 시작 시점의 겹친 실행 경고는 바로 보여 준다(stderr) — 끝날 때까지 기다리지 않고 멈출 수 있게 한다.
RECORD_ID=$(node "$RECORD_SCRIPT" --root "$RECORD_ROOT" begin pre-push "$RECORD_SCOPE") || RECORD_ID=""
if [ -n "$RECORD_ID" ]; then
  echo "  → execution record: build/verification-runs/$RECORD_ID.jsonl"
else
  echo "  ⚠ 실행 기록을 시작하지 못했습니다 — 검사는 그대로 실행합니다" >&2
fi
EGOV_VERIFICATION_RUN_ID=$RECORD_ID
export EGOV_VERIFICATION_RUN_ID
RECORD_STAGE=""
RECORD_SIGNAL=""
record_start() {
  RECORD_STAGE=$1
  [ -z "$RECORD_ID" ] || node "$RECORD_SCRIPT" --root "$RECORD_ROOT" step-start "$RECORD_ID" "$RECORD_STAGE" || :
}
record_end() {
  if [ -n "$RECORD_ID" ] && [ -n "$RECORD_STAGE" ]; then
    node "$RECORD_SCRIPT" --root "$RECORD_ROOT" step-end "$RECORD_ID" "$RECORD_STAGE" "$1" "$RECORD_SIGNAL" || :
  fi
  RECORD_STAGE=""
}
record_finish() {
  RECORD_EXIT=$1
  record_end "$RECORD_EXIT"
  [ -z "$RECORD_ID" ] || node "$RECORD_SCRIPT" --root "$RECORD_ROOT" finish "$RECORD_ID" "$RECORD_EXIT" "$RECORD_SIGNAL" || :
}
trap 'record_finish $?' 0
trap 'RECORD_SIGNAL=SIGINT; exit 130' 2
trap 'RECORD_SIGNAL=SIGTERM; exit 143' 15

# Node 운영 계약 catalog는 전체 범위를 유지한다(로컬 약 11분 — 이 훅에서 가장 비싼 검사다).
# 문서 전용이면 연결·메모리·생성물 계약을 확인하고 끝난다. 소스 변경이면 컴파일·타입·lint·폼 census 같은 정적 검사와
# 불변식·원문 계약·cross-stack Vitest·하네스가 먼저 실패를 알린 뒤 맨 끝에 실행한다(fail-fast). 두 경로 모두 정확히 한 번 돈다(삭제 전용 push 는 그 전에 끝난다).
run_operational_contracts() {
  echo "  → governance: npm run test:operational-contracts"
  record_start operational-contracts
  npm run test:operational-contracts \
    || { record_end "$?"; echo "❌ 운영 계약 실패 — 하네스 registry, CI scope, 문서·메모리 또는 실행 경로가 불일치합니다"; exit 1; }
  record_end 0
}

# Atlas는 전용 docs-as-code 계약을 통과한 경우에만 문서 fast-pass를 허용한다.
run_atlas_contract() {
  if [ -n "$CHANGED_FILES" ]; then
    if [ "$SCOPE_ATLAS" = "true" ]; then
      # frontend 불변식 및 backend cross-stack 실행은 Atlas를 이미 포함한다.
      if [ -f frontend/package.json ] && { [ "$SCOPE_BACKEND" = "true" ] || [ "$SCOPE_FRONTEND" = "true" ]; }; then
        echo "  → atlas: frontend/cross-stack 실행에 포함"
      else
        echo "  → atlas: pnpm -C frontend exec vitest run src/__tests__/cross-stack/governance-atlas-contract.test.ts"
        record_start atlas
        pnpm -C frontend exec vitest run src/__tests__/cross-stack/governance-atlas-contract.test.ts \
          || { record_end "$?"; echo "❌ Governance Atlas 계약 실패 — 현행 코드·모듈·접근성 계약과 불일치합니다"; exit 1; }
        record_end 0
      fi
    fi
  fi
}

# 생성물·해시 결속이 낡았는지 맨 앞에서 본다(npm run regen -- --check — 쓰지 않는다, 로컬 약 20초). 생성 계약·권한·슬롯·경계
# census·화면 목록·URL census(승인 결속)·SAST 예외 해시·하네스 기준선·Atlas 의 각 검사 모드와, regen 이 고치지 않는 손 결속 원장
# 확인(operation census 의 수·래칫, IA 처분 제안의 라우트 원장 결속 해시, scripts/ledger-precheck.mjs 의 태그 시험 gates.json 등록·
# 메뉴 snapshot 해시·기본 그룹 없는 권한의 기능 파일 안내)이다. 모두 운영 계약·CI codegen 게이트가 같은 판정으로 다시 보는 것이라
# 새 검사가 아니다 — 11분짜리 운영 계약 뒤가 아니라 처음에 알린다. 문서만 바꿔도 Atlas 가 낡으므로 두 경로 모두 돈다.
# [계약 드리프트 게이트] 생성 계약 검사(sync-contract)는 프런트 codegen:verify·codegen:verify:zod 와 같은 스크립트·인자다
# (scripts/verify-generated-contracts.mjs api·zod — 경로는 스크립트 위치 기준 절대 경로라 cwd 와 무관하다). index 의 api-docs.json 으로
# 임시 재생성해 index 생성물과 비교하고, 작업 트리가 다르면 작업 트리 쌍도 비교하며, 스펙·생성물이 추적되지 않으면 실패한다.
# 그래서 이 훅의 유일한 로컬 계약 드리프트 게이트이고 아래 프런트 단계에서 다시 돌리지 않는다. CI 는 frontend-scope 가 커밋 체크아웃에서 돈다.
echo "  → generated: npm run regen -- --check"
record_start generated-freshness
npm run regen -- --check \
  || { record_end "$?"; echo "❌ 낡은 생성물·해시 결속 — 'npm run regen' 으로 다시 만들고 diff 를 확인한 뒤 함께 커밋하세요(SAST 예외는 위 안내대로 재검토 뒤 결속)"; exit 1; }
record_end 0

if [ -n "$CHANGED_FILES" ]; then
  if [ "$SCOPE_DOCS_ONLY" = "true" ]; then
    run_operational_contracts
    run_atlas_contract
    echo "[pre-push] 📝 문서/비코드 변경만 감지됨 — 컴파일 및 하네스 검증 생략 (Fast-pass)"
    echo "  → 변경 파일:"
    echo "$CHANGED_FILES" | sed 's/^/     - /'
    exit 0
  fi
fi

echo "[pre-push] AGENTS.md change-scoped source verification"

# CI 의 CodeQL(secure-coding)이 반복해 막아 온 JavaScript 규칙 셋(file-system-race·incomplete-sanitization·redos)의 로컬 근사(수 초).
# 세 규칙은 함수·정규식 안의 판정이라 push 가 바꾼 파일만 본다(범위를 모르면 CodeQL 경로 전체). 판정 권위는 CI CodeQL 이다.
echo "  → sast: npm run sast:approx -- --stdin (CodeQL 근사, push 가 바꾼 JS·TS)"
record_start sast
printf '%s\n' "$CHANGED_FILES" | npm run sast:approx -- --stdin \
  || { record_end "$?"; echo "❌ CodeQL 근사 위반 — CI secure-coding 이 같은 모양을 막아 왔습니다. 고친 뒤 push 하세요(근사를 이유로 CodeQL 예외 원장을 늘리지 않습니다)"; exit 1; }
record_end 0

if [ "$SCOPE_BACKEND" = "true" ]; then
  echo "  → backend: ./gradlew compileJava compileTestJava"
  record_start backend-compile
  ./gradlew compileJava compileTestJava -q \
    || { record_end "$?"; echo "❌ Java 컴파일 실패 — 빌드 에러 0건 이후에만 push 허용 (AGENTS.md Verification)"; exit 1; }
  record_end 0
else
  echo "  → backend: 변경 영향 없음 — Java compile/harness 생략"
fi

if [ "$SCOPE_MIGRATION" = "true" ] && [ "$SCOPE_BACKEND" != "true" ]; then
  echo "  → migration: ./gradlew :migration-tool:compileJava :migration-tool:compileTestJava"
  record_start migration-compile
  ./gradlew :migration-tool:compileJava :migration-tool:compileTestJava -q \
    || { record_end "$?"; echo "❌ Migration CLI 컴파일 실패"; exit 1; }
  record_end 0
fi

if [ "$SCOPE_FRONTEND" = "true" ] && [ -f frontend/package.json ]; then
  # type-check 는 next typegen 으로 라우트 타입(.next/types)을 새로 만든 뒤 tsc 를 돈다 — next build 의 타입 검사와 같은 전제다.
  # 디스크에 남은 낡은 생성물(build·dev 시점의 라우트)이 결과를 바꾸지 않게 한다(2026-10-29 TS2344, tsconfig 의 .next/dev 제외 참조).
  echo "  → frontend: pnpm run type-check (next typegen → tsc --noEmit)"
  record_start frontend-types
  ( cd frontend && pnpm run type-check ) \
    || { record_end "$?"; echo "❌ 라우트 타입 생성 또는 TypeScript 타입 검사 실패 (AGENTS.md Verification)"; exit 1; }
  record_end 0

  # 루트 tsconfig가 제외하는 E2E 스펙·fixture·POM을 별도 구성으로 검사한다.
  echo "  → frontend: npx tsc -p tsconfig.e2e.json --noEmit (E2E 스펙·POM)"
  record_start e2e-types
  ( cd frontend && npx tsc -p tsconfig.e2e.json --noEmit ) \
    || { record_end "$?"; echo "❌ E2E TypeScript 타입 검사 실패 — 루트 tsconfig 는 e2e 를 exclude 하므로 이 게이트가 유일 관문입니다."; exit 1; }
  record_end 0

  # 계약 드리프트(api-docs.json ↔ generated-api.d.ts/generated-zod.ts/generated-operations.ts)는 맨 앞의 regen --check 가 같은
  # 검증 스크립트로 이미 봤다 — 여기서 codegen:verify·:zod 를 다시 돌리지 않는다(위 [계약 드리프트 게이트]).

  # ESLint error는 계약 위반으로 차단하고 warning은 package.json 래칫으로 관리한다.
  echo "  → frontend: pnpm run lint (error 만 차단 — warning 은 통과)"
  record_start frontend-lint
  ( cd frontend && pnpm run lint ) \
    || { record_end "$?"; echo "❌ ESLint 에러 — 경고는 package.json 래칫 범위에서 통과하지만 error는 수정해야 합니다."; exit 1; }
  record_end 0

  echo "  → frontend: pnpm run test:form-validation (폼 경계·validation 증거 census)"
  record_start form-validation
  ( cd frontend && pnpm run test:form-validation ) \
    || { record_end "$?"; echo "❌ 폼 validation census 실패 — 신규/누락 경계를 분류하고 비준수 화면의 검증·오류 이동·서버 오류·pending 증거를 보완하세요."; exit 1; }
  record_end 0
fi

if [ "$SCOPE_FRONTEND" = "true" ] && [ -f frontend/package.json ]; then
  # 빠른 저장소 불변식과 원문 계약만 pre-push에서 실행하고 전수 Vitest/coverage는 CI가 소유한다.
  # [DEC-OPS-390] 이 훅의 Vitest 세 단계는 scripts/vitest-timeout-rerun.mjs 로 돈다 — 실패가 모두 Vitest 시간 초과일 때만 그 파일을
  # 단독으로 한 번 다시 돌고(같은 기계의 다른 실행이 만든 부하의 거짓 red), 단언·모듈·처리되지 않은 오류는 그대로 막는다. CI 는 재실행이 없다.
  echo "  → frontend: vitest src/__tests__ (저장소 불변식 게이트)"
  record_start frontend-invariants
  ( cd frontend && node ../scripts/vitest-timeout-rerun.mjs src/__tests__ ) \
    || { record_end "$?"; echo "❌ 프런트 불변식 게이트 실패 — 위반을 수정하고 하향 래칫의 개선분은 정본에 반영하세요."; exit 1; }
  record_end 0

  # src/__tests__ 밖에서 저장소 파일을 직접 읽는 시험(원문 계약)은 import 그래프 밖이라 vitest related 로도 못 찾고 CI 전체 vitest 에서만
  # 돌았다(PR #626·2026-09-16 layout.tsx·PR #969). 목록은 탐지기가 매번 계산한다 — 탐지 실패·0건은 생략이 아니라 차단이다.
  echo "  → frontend: vitest 원문 계약 (node scripts/frontend-source-contracts.mjs)"
  record_start frontend-source-contracts
  FRONTEND_SOURCE_CONTRACTS=$(node scripts/frontend-source-contracts.mjs) \
    || { record_end "$?"; echo "❌ 원문 계약 목록을 계산하지 못했습니다 — 탐지기 실패는 생략이 아니라 차단입니다"; exit 1; }
  # set -f: 대괄호 경로([id] 등)가 글로브로 펼쳐지지 않게 한다. 공백 경로는 탐지기가 막는다.
  ( cd frontend && set -f && node ../scripts/vitest-timeout-rerun.mjs $FRONTEND_SOURCE_CONTRACTS ) \
    || { record_end "$?"; echo "❌ 원문 계약 실패 — 바꾼 소스·설정을 원문으로 읽는 시험이 어긋납니다(CI frontend-coverage-scope 가 같은 시험을 돕니다)"; exit 1; }
  record_end 0
fi

# 크로스 스택 계약(frontend/src/__tests__/cross-stack)은 백엔드 소스를 함께 감사한다.
# 프런트 게이트가 생략되는 백엔드-only push 에서도 이 하위 집합은 실행해야
# "감사 대상만 고치면 감사자가 돌지 않는" 경로가 생기지 않는다(H5).
if [ "$SCOPE_BACKEND" = "true" ] && [ "$SCOPE_FRONTEND" != "true" ] && [ -f frontend/package.json ]; then
  echo "  → cross-stack: vitest src/__tests__/cross-stack (frontend↔backend 진실 결속)"
  record_start cross-stack
  ( cd frontend && node ../scripts/vitest-timeout-rerun.mjs src/__tests__/cross-stack ) \
    || { record_end "$?"; echo "❌ 크로스 스택 계약 실패 — 백엔드 변경이 프런트 화면의 고지·문구 계약과 어긋납니다"; exit 1; }
  record_end 0
fi

# 헌법·표준 governance 하네스. 로컬은 우회 가능하며 authoritative merge gate는 CI다.
# 우회: SKIP_HARNESS=1 git push
if [ "$SCOPE_BACKEND" = "true" ]; then
  if [ -z "$SKIP_HARNESS" ]; then
    echo "  → harness: ./gradlew :api-server:harnessTest"
    record_start harness
    ./gradlew :api-server:harnessTest -q \
      || { record_end "$?"; echo "❌ 하네스 게이트 실패 — 헌법/표준 린터 위반. 리포트: api-server/build/reports/tests/harnessTest/index.html"; echo "   ⚠ 목록(동결·예외)을 고쳐 신호를 지우는 것은 수정이 아니라 은폐다 (AGENTS.md Evidence guardrails H2)"; exit 1; }
    record_end 0
  else
    echo "  ⚠ harness 게이트 건너뜀(SKIP_HARNESS) — CI 또는 로컬에서 별도 실행 필요"
    [ -z "$RECORD_ID" ] || node "$RECORD_SCRIPT" --root "$RECORD_ROOT" skip "$RECORD_ID" harness explicit-bypass || :
  fi
fi

# 실패가 잦고 짧은 검사(정적 검사·불변식·원문 계약·cross-stack Vitest·하네스)를 모두 통과한 뒤에 비싼 운영 계약을 돌린다.
# 불변식·원문 계약·cross-stack·하네스를 운영 계약 뒤에 두었을 때 실패한 push 들은 508~859초를 기다린 뒤에야 그 단계에서 붉었다.
run_operational_contracts
run_atlas_contract

echo "[pre-push] ✅ 변경 영향 범위의 컴파일·계약·하네스 게이트 통과"
