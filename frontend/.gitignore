# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# 부트스트랩(make bootstrap / bootstrap.ps1)이 .env.local 로 복제하는 템플릿은 추적한다
# (시크릿 없음: NEXT_PUBLIC_API_URL 등 로컬 기본값만) — fresh clone 에서 복제 대상이 존재하도록.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
