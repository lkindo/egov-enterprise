{
  "compilerOptions": {
    "target": "ESNext",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    // [2026-08-09] 미사용 선언 219건을 정리하고 켠다.
    //   켜기 전 서버 액션 7개가 **호출될 수 없는 채로** 살아 있었고(별도 게이트로 차단),
    //   그 외에도 미사용 import 160·타입 30·지역선언 29 가 남아 있었다.
    "noUnusedLocals": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "types": [
      "vitest/globals",
      "@testing-library/jest-dom",
      "node"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  // [2026-10-29] .next/dev 는 next dev 가 따로 갱신하는 둘째 라우트 타입 사본이다. .next/types 와 같은 전역 타입을 다시 선언하므로
  //   둘 중 하나가 낡으면 src 와 무관한 TS2344·TS2307 이 난다(2026-10-29 select-board-list layout). next build 의 타입 검사도
  //   이 경로를 거른다(next/dist/lib/typescript/type-paths.js getDevTypesPath). include 의 두 .next glob 은 Next 가 다시 써 넣으므로
  //   지우지 않고 여기서만 뺀다 — .next/types 는 type-check 스크립트가 tsc 직전에 next typegen 으로 새로 만든다.
  "exclude": [
    "node_modules",
    "scripts",
    "vitest.config.mts",
    "vitest.setup.ts",
    "e2e",
    ".next/dev"
  ]
}
