{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--max-old-space-size=8192 next dev -p 3001",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=8192 next build",
    "build:instrumented": "node scripts/build-instrumented.js",
    "start": "next start",
    "start:3001": "next start -p 3001",
    "lint": "eslint src --config eslint.config.mjs --max-warnings 460",
    "type-check": "tsc --noEmit",
    "codegen:ts": "openapi-typescript http://localhost:8080/v3/api-docs -o src/types/generated-api.d.ts",
    "codegen:file": "openapi-typescript ../api-docs.json -o src/types/generated-api.d.ts",
    "codegen:verify": "git ls-files --error-unmatch src/types/generated-api.d.ts && npm run codegen:file && git diff --exit-code src/types/generated-api.d.ts",
    "codegen:zod": "node ../.agent/scripts/codegen-zod.js",
    "codegen:verify:zod": "git ls-files --error-unmatch src/types/generated-zod.ts && npm run codegen:zod && git diff --exit-code src/types/generated-zod.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "cross-env NODE_OPTIONS=--max-old-space-size=8192 playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:cleanup": "npx tsx e2e/scripts/cleanup-db.ts",
    "test:e2e:full": "npm run test:cleanup && playwright test && npm run test:cleanup",
    "lighthouse": "lhci autorun",
    "lighthouse:desktop": "lhci autorun --collect.settings.preset=desktop",
    "lighthouse:mobile": "lhci autorun --collect.settings.preset=mobile",
    "analyze": "cross-env ANALYZE=true next build --webpack",
    "analyze:server": "cross-env ANALYZE=true npm run build",
    "analyze:browser": "cross-env ANALYZE=true npm run build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "storybook:test": "test-storybook",
    "storybook:clean": "rm -rf storybook-static",
    "coverage:report": "nyc report --reporter=html --reporter=text",
    "coverage:clean": "node -e \"const fs=require('fs'); fs.rmSync('.nyc_output',{recursive:true,force:true}); fs.rmSync('coverage',{recursive:true,force:true})\"",
    "test:e2e:coverage": "node scripts/run-e2e-with-coverage.js",
    "clean-deps:check": "npx depcheck"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-switch": "^1.2.6",
    "@stomp/stompjs": "^7.3.0",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-query-devtools": "^5.90.21",
    "@tiptap/extension-character-count": "^3.20.4",
    "@tiptap/extension-image": "^3.20.4",
    "@tiptap/extension-link": "^3.20.4",
    "@tiptap/extension-text-align": "^3.20.4",
    "@tiptap/react": "^3.20.4",
    "@tiptap/starter-kit": "^3.20.4",
    "axios": "^1.19.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "fast-glob": "^3.3.3",
    "framer-motion": "^12.34.3",
    "isomorphic-dompurify": "^3.10.0",
    "lucide-react": "^0.563.0",
    "next": "^16.2.4",
    "next-intl": "^4.13.2",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "19.0.0",
    "react-day-picker": "^9.13.1",
    "react-dom": "19.0.0",
    "react-hook-form": "^7.71.1",
    "recharts": "^3.7.0",
    "sockjs-client": "^1.6.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@lhci/cli": "^0.15.1",
    "@next/bundle-analyzer": "^15.1.7",
    "@playwright/test": "^1.58.2",
    "@storybook/nextjs": "^10.3.3",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/pg": "^8.18.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sockjs-client": "^1.5.4",
    "@types/winston": "^2.4.4",
    "@vitejs/plugin-react": "^5.1.3",
    "@vitest/coverage-v8": "^4.0.18",
    "babel-plugin-istanbul": "^8.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jsdom": "^28.0.0",
    "msw": "^2.14.6",
    "nyc": "^18.0.0",
    "openapi-typescript": "^7.13.0",
    "pg": "^8.20.0",
    "pretty-format": "^30.3.0",
    "shadcn": "^3.8.4",
    "storybook": "^10.3.3",
    "tailwindcss": "^4",
    "ts-morph": "^28.0.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.0.18",
    "winston": "^3.19.0",
    "yargs-parser": "^22.0.0"
  },
  "pnpm": {
    "overrides": {
      "websocket-driver": ">=0.7.5"
    }
  }
}
