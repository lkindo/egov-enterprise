{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--max-old-space-size=8192 next dev -p 3001",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=8192 next build",
    "bundle:check": "node scripts/check-bundle-budget.mjs",
    "build:instrumented": "node scripts/build-instrumented.js",
    "start": "next start",
    "start:3001": "next start -p 3001",
    "lint": "eslint src e2e --config eslint.config.mjs --max-warnings 260",
    "type-check": "tsc --noEmit",
    "type-check:e2e": "tsc -p tsconfig.e2e.json --noEmit",
    "codegen:ts": "openapi-typescript http://localhost:8080/v3/api-docs -o src/types/generated-api.d.ts",
    "codegen:file": "openapi-typescript ../api-docs.json -o src/types/generated-api.d.ts",
    "codegen:verify": "git ls-files --error-unmatch src/types/generated-api.d.ts && npm run codegen:file && git diff --exit-code src/types/generated-api.d.ts",
    "codegen:zod": "node ../.agent/scripts/codegen-zod.js",
    "codegen:verify:zod": "git ls-files --error-unmatch src/types/generated-zod.ts && npm run codegen:zod && git diff --exit-code src/types/generated-zod.ts",
    "format:api-docs": "node -e \"const fs=require('fs'); const p='../api-docs.json'; if(fs.existsSync(p)){ const d=JSON.parse(fs.readFileSync(p,'utf8')); fs.writeFileSync(p, JSON.stringify(d, null, 2)+'\\n'); }\"",
    "syncContract": "pnpm run codegen:file && pnpm run codegen:zod && pnpm run format:api-docs",
    "test": "vitest run --coverage",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "cross-env NODE_OPTIONS=--max-old-space-size=8192 playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:cleanup": "npx tsx e2e/scripts/cleanup-db.ts",
    "test:e2e:full": "npm run test:cleanup && playwright test && npm run test:cleanup",
    "lighthouse": "npx --yes @lhci/cli@0.15.1 autorun",
    "lighthouse:desktop": "npx --yes @lhci/cli@0.15.1 autorun --collect.settings.preset=desktop",
    "lighthouse:mobile": "npx --yes @lhci/cli@0.15.1 autorun --collect.settings.preset=mobile",
    "analyze": "cross-env ANALYZE=true next build --webpack",
    "analyze:server": "cross-env ANALYZE=true npm run build",
    "analyze:browser": "cross-env ANALYZE=true npm run build",
    "coverage:report": "nyc report --reporter=html --reporter=text",
    "coverage:clean": "node -e \"const fs=require('fs'); fs.rmSync('.nyc_output',{recursive:true,force:true}); fs.rmSync('coverage',{recursive:true,force:true})\"",
    "test:e2e:coverage": "node scripts/run-e2e-with-coverage.js",
    "clean-deps:check": "npx depcheck"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.5.7",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-switch": "^1.3.7",
    "@stomp/stompjs": "^7.3.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@tiptap/extension-character-count": "^3.29.2",
    "@tiptap/extension-image": "^3.29.2",
    "@tiptap/extension-link": "^3.29.2",
    "@tiptap/extension-text-align": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "axios": "^1.19.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "fast-glob": "^3.3.3",
    "framer-motion": "^12.43.0",
    "isomorphic-dompurify": "^3.20.0",
    "lucide-react": "^1.28.0",
    "next": "^16.2.12",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-day-picker": "^9.13.1",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.83.0",
    "recharts": "^3.10.1",
    "sockjs-client": "^1.6.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@next/bundle-analyzer": "^15.1.7",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/sockjs-client": "^1.5.4",
    "@types/winston": "^2.4.4",
    "@vitejs/plugin-react": "^5.1.3",
    "@vitest/coverage-v8": "^4.1.10",
    "babel-plugin-istanbul": "^8.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jsdom": "^30.0.1",
    "msw": "^2.15.0",
    "nyc": "^18.0.0",
    "openapi-typescript": "^7.13.0",
    "pg": "^8.22.0",
    "pretty-format": "^30.3.0",
    "shadcn": "^3.8.4",
    "tailwindcss": "^4",
    "ts-morph": "^28.0.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "winston": "^3.19.0",
    "yargs-parser": "^22.0.0"
  },
  "pnpm": {
    "comment": "overrides 는 **전이 의존**의 취약 버전만 최소로 끌어올린다. 키를 'pkg@<취약범위>' 로 한정한 이유: 무범위 '>=X' 는 트리의 모든 인스턴스를 강제해 메이저를 넘겨 버린다 — 실제로 js-yaml 을 '>=4.3.0' 으로 두자 5.2.3 이 설치돼 @redocly/openapi-core(v4 API 인 types.merge 사용)가 깨졌고 codegen 계약 게이트가 red 가 됐다. 같은 이유로 brace-expansion(2→5)·undici(7→8)·fast-uri(3→4)도 메이저를 넘고 있었다. 각 항목은 Dependabot HIGH 알림의 vulnerable_version_range → first_patched_version 이며, 상위 패키지가 스스로 취약 범위를 벗어나면 제거할 것. 직접 의존(next·axios)은 여기가 아니라 dependencies 의 범위를 올렸다 — pnpm install 은 lockfile 이 기존 범위를 이미 만족하면 올리지 않아, 캐럿만 믿으면 취약 버전에 머문다(실측: next 16.2.6, axios 1.16.1 고착). vite 는 auto-installed peer 라 overrides 가 해석에 반영되지 않아 devDependencies 에 명시 선언했다. [2026-08-07 2차 상환] 상위 패키지가 움직여 기존 범위가 낡은 항목(fast-uri·postcss·js-yaml·tmp·hono)을 새 first_patched_version 으로 갱신하고, 신규 3건(@hono/node-server·ip-address·brace-expansion 5.x 라인)을 추가했다. brace-expansion 은 락에 1.1.18/2.1.2/5.0.6 세 인스턴스가 공존하므로 2.x/5.x 라인을 따로 좁혀 잡는다 — 무범위였다면 1.x 까지 5 로 끌어올려 깨졌을 것이다. **의도적 미포함**: uuid(락 8.3.2 뿐인데 패치는 11.1.1 — 3메이저 도약이고 취약 API 는 buf 를 넘기는 v3/v5/v6 뿐이라 dev 도구 경로에서 도달하지 않는다), elliptic(패치 버전 자체가 없음 — **2026-08-07 Storybook 제거로 유입 경로 자체가 사라져 해소됨**). [2026-08-07 추가 상환] @hono/node-server 를 2.0.5 -> 2.0.10 으로 재상향했다. 2.0.5 로 올린 직후(같은 날 02:18) '중단된 WebSocket 핸드셰이크를 통한 무인증 메모리 누수 DoS' 권고가 새로 게시되며 취약 범위가 '<=2.0.9' 로 넓어졌다 — override 는 상위 패키지가 아니라 **권고가 움직여도** 낡는다는 사례다. [2026-08-12 3차 상환] 신규 brace-expansion 우회 DoS 권고에 따라 2.x/5.x 를 각각 2.1.4/5.0.9로, body-parser 2.x를 2.3.0으로 올렸다.",
    "overrides": {
      "websocket-driver": ">=0.7.5",
      "brace-expansion@>=2.0.0 <2.1.4": "2.1.4",
      "brace-expansion@>=3.0.0 <5.0.9": "5.0.9",
      "body-parser@>=2.0.0 <2.3.0": "2.3.0",
      "undici@>=7.0.0 <7.28.0": "7.28.0",
      "fast-uri@>=3.0.0 <3.1.5": "3.1.5",
      "js-yaml@>=4.0.0 <4.3.1": "4.3.1",
      "postcss@<=8.5.22": "8.5.23",
      "esbuild@>=0.27.3 <0.28.1": "0.28.1",
      "form-data@>=4.0.0 <4.0.6": "4.0.6",
      "hono@<4.12.34": "4.12.34",
      "@hono/node-server@<2.0.10": "2.0.10",
      "ip-address@<=10.3.0": "10.3.1",
      "nanoid@<3.3.18": "3.3.18",
      "sharp@<0.35.0": "0.35.0",
      "tmp@<0.2.7": "0.2.7"
    }
  }
}
