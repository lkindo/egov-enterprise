# ============================================================
# .env.example - 프론트엔드 환경변수 예제 템플릿
# 복제 대상: frontend/.env.local
# ============================================================

# 로컬 개발 API URL
NEXT_PUBLIC_API_URL=http://127.0.0.1:8080/api/v1

# 백엔드 직접 호출 URL (SSR 서버사이드 전용, 선택사항)
# BACKEND_API_URL=http://127.0.0.1:8080/api/v1/

# 평문 HTTP local loopback에서만 인증 쿠키 Secure를 생략하는 서버 전용 opt-in.
# 기본은 fail-closed다. 필요한 경우 서버를 loopback에만 bind한 로컬 환경에서만 true로 바꾸며,
# 공유 개발·preview·staging에는 설정하지 않는다.
ALLOW_INSECURE_LOOPBACK_AUTH_COOKIE=false

# 브랜드 프로필 축 (data-brand-theme). allowlist: premium | krds-aligned. 미설정 시 premium.
# 라우트별 배정은 ADR-0004 금지 — 전역 <html> 한 곳에만 배선된다(src/lib/theme/brand-theme.ts).
BRAND_THEME=premium

# 밀도 축 (data-density) — 브랜드와 직교. allowlist: comfortable | compact. 미설정 시 comfortable(렌더링 무변화).
# ERP 고밀도 배포는 compact 로 켠다. 라우트별 배정은 ADR-0004 금지 — 전역 <html> 한 곳에만 배선된다(src/lib/theme/density.ts).
UI_DENSITY=comfortable
