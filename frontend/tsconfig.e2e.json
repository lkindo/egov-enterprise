// ─────────────────────────────────────────────────────────────────────────────
// E2E 전용 타입 게이트 (2026-08-10 신설)
//
// 왜 필요한가: 루트 `tsconfig.json` 의 exclude 에 `"e2e"` 가 들어 있다. 그래서
//   AGENTS.md "Verification by change scope"의 프론트엔드 타입 게이트도, pre-push도, CI도 **E2E 스펙을 한 번도
//   타입 검사한 적이 없다.** Playwright 러너는 타입을 검사하지 않고 벗겨내기만 하므로
//   (transpile-only), E2E 의 타입 오류는 지금까지 어떤 게이트에도 걸리지 않았다.
//   그 결과 오타난 셀렉터 상수·사라진 Page Object 메서드·미사용 import 같은 것들이
//   **4분짜리 CI E2E 잡이 실패해야만** 드러났다.
//
// 무엇을 검사하는가: e2e/ 전체 + playwright.config.ts.
//   루트 설정을 상속하되 include/exclude 를 덮어써 대상만 바꾼다. 규칙(strict,
//   noUnusedLocals 등)은 앱 코드와 동일하게 적용한다 — 테스트 코드에만 느슨한 기준을
//   두면 그쪽부터 썩는다.
//
// 실행 경로(H5 — 실행되지 않는 게이트는 없는 게이트다):
//   · 로컬/훅: `pnpm -C frontend run type-check:e2e` (.githooks/pre-push 에 결속)
//   · 수동:    `npx tsc -p tsconfig.e2e.json --noEmit`
// ─────────────────────────────────────────────────────────────────────────────
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // 루트는 vitest/@testing-library 전역을 주입한다. E2E 는 Playwright 의 test/expect 를
    // 명시 import 하므로 그 전역들이 섞이면 어느 `expect` 인지 모호해진다 — node 만 남긴다.
    "types": [
      "node"
    ],
    "noEmit": true,
    // 루트의 incremental 은 tsconfig.tsbuildinfo 를 쓴다. 두 설정이 같은 파일을 두고
    // 다투면 캐시가 서로를 무효화하므로 이 게이트는 캐시를 쓰지 않는다(대상이 작아 비용이 없다).
    "incremental": false
  },
  "include": [
    "e2e/**/*.ts",
    "playwright.config.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
