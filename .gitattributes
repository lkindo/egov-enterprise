# Handle line endings automatically for files detected as text
# and leave binary files untouched.
* text=auto

# Denote all files that are truly vendor-specific or binary
# to prevent Git from trying to normalize them.
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary

# Explicitly set encoding for Java and other source files
*.java text working-tree-encoding=UTF-8
*.properties text working-tree-encoding=UTF-8
*.xml text working-tree-encoding=UTF-8
*.yml text working-tree-encoding=UTF-8
*.yaml text working-tree-encoding=UTF-8
*.js text working-tree-encoding=UTF-8
*.ts text working-tree-encoding=UTF-8
*.tsx text working-tree-encoding=UTF-8
*.jsx text working-tree-encoding=UTF-8
*.json text working-tree-encoding=UTF-8
*.md text working-tree-encoding=UTF-8

# The r13 baseline binds these protocol/tooling files to exact Git blob bytes.
# Force identical checkout bytes on Windows so clean worktrees pass raw equality.
docs/04-operations/ui-ux-baseline-protocol.md text working-tree-encoding=UTF-8 eol=lf
frontend/scripts/ui-quality-baseline-core.mjs text working-tree-encoding=UTF-8 eol=lf
frontend/scripts/ui-quality-baseline-runner.mjs text working-tree-encoding=UTF-8 eol=lf
scripts/ui-quality-baseline-runner-contract.test.mjs text working-tree-encoding=UTF-8 eol=lf
scripts/ui-quality-scenarios-contract.test.mjs text working-tree-encoding=UTF-8 eol=lf

# Durable UI-quality summaries are byte-addressed. Keep checkout bytes identical
# across Windows and CI so SHA-256 and committed Git blob readback cannot drift.
config/ui-quality-baseline/** text working-tree-encoding=UTF-8 eol=lf
config/ui-quality-baseline-index.json text working-tree-encoding=UTF-8 eol=lf

# [2026-07-28 신설] 리눅스/컨테이너에서 실행되는 셸 스크립트는 반드시 LF 로 체크아웃한다.
#   위의 `* text=auto` 만으로는 core.autocrlf=true 인 Windows 체크아웃에서 CRLF 가 되고,
#   그러면 shebang 이 `#!/bin/sh\r` 로 읽혀 커널이 인터프리터를 찾지 못한다 → **exit 127**.
#   실측(2026-07-28): Windows 로컬 `docker compose build api` 가 Dockerfile:33
#   `RUN ./gradlew :api-server:bootJar` 에서 정확히 이 이유로 죽었다. CI(ubuntu, autocrlf 미적용)
#   에서는 LF 로 받으므로 드러나지 않아, **Windows 개발자만 이미지 빌드가 불가능한 상태**였다.
#   Dockerfile 의 `chmod +x` 는 실행비트만 방어할 뿐 CRLF 는 막지 못한다.
gradlew text eol=lf
*.sh text eol=lf

# 반대로 Windows 배치 파일은 CRLF 를 유지해야 cmd.exe 가 정상 해석한다.
gradlew.bat text eol=crlf
*.bat text eol=crlf
