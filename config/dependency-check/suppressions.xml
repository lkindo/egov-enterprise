<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
    <!--
    OWASP Dependency-Check Suppression File

    이 파일은 거짓 양성 (False Positive) 경보를 억제하거나,
    수용 가능한 위험으로 간주되는 취약점을 제외하는 데 사용합니다.

    사용 예:
    1. 특정 CVE 가 프로젝트에 영향을 주지 않는 경우
    2. 거짓 양성으로 확인된 경우
    3. 위험이 수용 가능한 경우

    참고: https://jeremylong.github.io/DependencyCheck/general/suppression.html
    -->

    <!-- H2 데이터베이스 (테스트 전용 의존성) -->
    <suppress>
        <notes><![CDATA[
        H2 database is only used for testing purposes, not in production.
        All vulnerabilities are acceptable as it's never deployed to production.
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/com\.h2database/h2@.*$</packageUrl>
        <vulnerabilityName>.*</vulnerabilityName>
    </suppress>

    <!-- Testcontainers (테스트 전용 의존성) -->
    <suppress>
        <notes><![CDATA[
        Testcontainers is only used for integration testing, not in production.
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.testcontainers/.*$</packageUrl>
        <vulnerabilityName>.*</vulnerabilityName>
    </suppress>

    <!-- Spring Boot DevTools (개발 전용 의존성) -->
    <suppress>
        <notes><![CDATA[
        Spring Boot DevTools is only used during development, not in production.
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.springframework\.boot/spring-boot-devtools@.*$</packageUrl>
        <vulnerabilityName>.*</vulnerabilityName>
    </suppress>

    <!-- Lombok (컴파일 전용 의존성) -->
    <suppress>
        <notes><![CDATA[
        Lombok is only used at compile time for code generation, not included in runtime.
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.projectlombok/lombok@.*$</packageUrl>
        <vulnerabilityName>.*</vulnerabilityName>
    </suppress>

    <!-- Jakarta XML Binding (레거시 호환성) -->
    <suppress>
        <notes><![CDATA[
        JAXB is used for XML parsing in legacy compatibility layer.
        No direct exposure to untrusted input.
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/jakarta\.xml\.bind/jakarta\.xml\.bind-api@.*$</packageUrl>
        <vulnerabilityName>.*</vulnerabilityName>
    </suppress>

    <!-- [2026-09-22 주간 NVD 판정] 아래 세 건은 CVE·패키지 단위로 좁혀 억제하고 재검토 기한(until)을 둔다.
         Spring Framework 6.2.19 · Security 6.5.11 · Integration 6.5.10 의 CVSS>=7 16건은 억제하지 않는다 —
         OSS 지원이 끝난 라인의 실제 미수정 CVE 이며 GAP-DEP-002 가 라인 결정과 함께 추적한다. -->

    <!-- kotlin-stdlib 1.9.25 (okhttp ← opentelemetry-exporter-otlp 경유, BOM 규칙으로 선택) -->
    <suppress until="2026-12-21Z">
        <notes><![CDATA[
        CVE-2026-53914 는 Kotlin Build Cache(kotlin-gradle-plugin, 수정 2.4.20)의 역직렬화 결함이고
        CVE-2020-29582 는 1.4.21 미만 createTempDir 결함이다. 둘 다 런타임 stdlib 1.9.25 에는 해당하지 않으며
        cpe:2.3:a:jetbrains:kotlin 으로 뭉뚱그려 매칭된 오탐이다. 빌드 플러그인은 buildEnvironment 경로에서 따로 본다.
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.jetbrains\.kotlin/kotlin-stdlib@1\.9\.25$</packageUrl>
        <cve>CVE-2026-53914</cve>
        <cve>CVE-2020-29582</cve>
    </suppress>

    <!-- OpenTelemetry Java 1.62.0 — JavaScript 패키지 @opentelemetry/core 의 CVE 가 CPE 이름만으로 매칭됐다 -->
    <suppress until="2026-12-21Z">
        <notes><![CDATA[
        CVE-2026-54285 는 npm @opentelemetry/core (<2.8.0) 의 W3C Baggage 전파 메모리 결함이다.
        cpe:2.3:a:opentelemetry:opentelemetry 가 언어를 구분하지 않아 Java SDK 1.62.0 전 모듈에 붙었다(오탐).
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/io\.opentelemetry/opentelemetry-.*@1\.62\.0$</packageUrl>
        <cve>CVE-2026-54285</cve>
    </suppress>
</suppressions>
