<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
    <!--
    OWASP Dependency-Check Suppression File
    
    이 파일은 거짓 양성 (False Positive) 경보를 억제하거나, 
    수용 가능한 위험으로 간주되는 취약점을 제외하는 데 사용합니다.
    
    사용 예:
    1. 특정 CVE 가 프로젝트에 영향을 주지 않는 경우
    2. 거짓 양성으로 확인된 경우
    3. 위험이 수용 가능한 경우
    
    참고: https://jeremylong.github.io/DependencyCheck/general/suppression.html
    -->
    
    <!-- 예시: 특정 라이브러리의 CVE 억제
    <suppress>
        <notes><![CDATA[
        This suppression is for a false positive in library X.
        The vulnerable method is not used in our codebase.
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/com\.example/library@.*$</packageUrl>
        <cve>CVE-2023-12345</cve>
    </suppress>
    -->
    
    <!-- 예시: H2 데이터베이스 (테스트 전용)
    <suppress>
        <notes><![CDATA[
        H2 database is only used for testing, not in production.
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/com\.h2database/h2@.*$</packageUrl>
        <vulnerabilityName>.*</vulnerabilityName>
    </suppress>
    -->
</suppressions>
