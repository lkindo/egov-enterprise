  "actionRules": [
    {
      "id": "verb-object",
      "rule": "Use a specific Korean verb and object, such as 사용자 추가 or 변경사항 저장.",
      "forbiddenExamples": ["확인", "처리", "실행", "GO", "DEPLOY"]
    },
    {
      "id": "pending-action",
      "rule": "While a mutation is pending, preserve the object and use 진행 중…, while preventing duplicate activation.",
      "forbiddenExamples": ["완료", "성공", "ACTIVE"]
    },
    {
      "id": "destructive-action",
      "rule": "Name the affected object, state reversibility and consequence, and distinguish cancel from delete.",
      "forbiddenExamples": ["정리", "초기화"]
    },
    {
      "id": "unsupported-action",
      "rule": "Do not render an enabled action without a handler and authoritative completion path; disable it with a reason or remove it.",
      "forbiddenExamples": ["cursor-only card", "handlerless button"]
    }
  ],
  "formatRules": {
    "date": {
      "display": "Use a shared ko-KR formatter; do not expose storage-only yyyyMMdd as a user-facing date.",
      "ambiguousNumericDates": "forbidden"
    },
    "time": {
      "display": "Show the relevant timezone when users can compare events across zones or when audit meaning depends on it.",
      "relativeOnlyForAudit": "forbidden"
    },
    "number": {
      "locale": "ko-KR",
      "unknownAsZero": "forbidden",
      "scopeQualifierRequired": true
    },
    "unit": {
      "requireUnit": true,
      "examples": ["건", "명", "초", "ms", "MB", "%"]
    }
  },
  "terms": [
    {
      "id": "term-hub",
      "sourceTerms": ["Hub", "허브"],
      "decision": "replace-by-task-context",
      "preferred": "목록, 관리, 현황, 작성 등 실제 과업 이름",
      "rationale": "A container metaphor does not explain the user's task."
    },
    {
      "id": "term-intelligence",
      "sourceTerms": ["Intelligence", "인텔리전스", "인텔리전트 엔진"],
      "decision": "forbidden-unless-source-proven",
      "preferred": "검색, 추천, 요약 등 검증된 기능 이름",
      "rationale": "The term overclaims unspecified AI or analysis capability."
    },
    {
      "id": "term-matrix-node-stream",
      "sourceTerms": ["Matrix", "Node", "Stream", "매트릭스", "노드", "스트림"],
      "decision": "replace-by-domain-noun",
      "preferred": "표, 항목, 목록, 알림 등 사용자 도메인 명사",
      "rationale": "Internal system metaphors increase interpretation cost."
    },
    {
      "id": "term-architecture-protocol-core",
      "sourceTerms": ["Architecture", "Protocol", "Core", "아키텍처", "프로토콜", "코어"],
      "decision": "audience-and-context-required",
      "preferred": "설정, 보안 상태, 게시물 작성 등 결과 중심 표현",
      "rationale": "Technical terms are allowed in adopter documentation but not as decorative end-user copy."
    },
    {
      "id": "term-operational-status",
      "sourceTerms": ["ACTIVE", "SAFE", "HIGH", "OPTIMAL", "정상", "안전"],
      "decision": "evidence-required",
      "preferred": "측정 출처·시각·범위가 있는 한국어 상태 또는 상태 미확인",
      "rationale": "Unqualified status words are not operational evidence."
    },
    {
      "id": "term-standard-acronyms",
      "sourceTerms": ["ID", "IP", "URL", "API", "CSV", "CPU"],
      "decision": "conditional",
      "preferred": "해당 역할이 이해할 수 있는 한국어 설명과 첫 사용 병기",
      "rationale": "Some acronyms are necessary identifiers or audit concepts, but audience and explanation matter."
    }
  ],
