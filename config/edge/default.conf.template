# 운영 앞단 프록시 — 클라이언트 IP 신뢰 경계 (ADR-0019, GAP-SEC-004)
#
# 이 프록시가 브라우저의 유일한 진입점이다. 역할은 하나다: 뒤로 넘기는 X-Forwarded-For 를
# **이 프록시가 본 접속 주소로 덮어쓴다.** 클라이언트가 보낸 X-Forwarded-For 는 버린다.
#
#   종전 운영 형상은 Next(3000)를 호스트에 직접 공개했다. Next 는 X-Forwarded-For 가 없을 때만
#   소켓 주소로 채우므로(`??=`) 클라이언트가 보낸 값이 그대로 남았고, 백엔드는 신뢰 대역인 Next 를
#   피어로 보고 그 값을 사용자 IP 로 채택했다. 한편 로그인 BFF 는 헤더를 싣지 않아 모든 로그인이
#   Next IP 하나로 모였다. 이 프록시가 앞에 서야 두 경로가 같은 실제 주소를 쓴다.
#
# 앞에 LB·TLS 종단이 따로 있으면 EDGE_TRUSTED_UPSTREAM 에 그 대역을 준다. 그 대역에서 온 요청만
# 그 LB 가 붙인 X-Forwarded-For 를 따라가 실제 주소를 복원한다(real_ip). 기본값은 루프백이라
# 사실상 아무 상위도 신뢰하지 않는다.
#
# ⚠ Docker 호스트의 userland-proxy 가 켜져 있으면 외부 접속의 원 주소가 브리지 게이트웨이로 바뀐다.
#   그 주소는 백엔드의 신뢰 대역 안이라 사용자별 판정이 다시 한 주소로 모인다(위조는 되지 않는다).
#   운영 호스트는 daemon.json 의 "userland-proxy": false 로 둔다(docs/04-operations 배포 안내).

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# 로그인 요청 제한 (ADR-0059)
#
# 백엔드 로그인 버킷(RateLimitFilter)은 인스턴스 메모리라 api 를 여러 대 띄우면 한 주소의 시도가 대수만큼 늘어난다.
# 브라우저의 모든 요청이 지나는 여기서 같은 한도를 한 번 더 건다. 한도는 백엔드와 같은 변수
# RATE_LIMIT_LOGIN_REQUESTS_PER_MINUTE 에서 온다(운영 오버레이가 EDGE_LOGIN_REQUESTS_PER_MINUTE 로 넘긴다).
#   경로 집합은 백엔드 로그인 버킷과 같다. 판정은 nginx 가 디코딩·정규화한 $uri 로 한다 — 인코딩(%6e)이나 중복 슬래시로
#   비껴가지 못한다. 키가 빈 요청(그 밖의 경로)은 세지 않는다.
map $uri $edge_login_limit_key {
    default                         "";
    ~*^/api/auth/(login|mfa/)       $binary_remote_addr;
    ~*^/api/v1/auth/(login|mfa/)    $binary_remote_addr;
    ~*^/api/v1/users/me/password    $binary_remote_addr;
}

# 거부 본문은 그 경로의 실패 응답 계약과 같다 — 화면은 백엔드가 막을 때와 같은 안내를 보인다.
#   로그인 BFF: frontend/src/lib/auth/login-error.ts, 추가 인증 BFF: frontend/src/app/api/auth/mfa/[...path]/route.ts,
#   백엔드 직접 경로: RateLimitFilter. 문구가 갈라지면 edge 신뢰 경계 계약이 붉다.
map $uri $edge_login_limited_body {
    default                         '{"success":false,"code":"C429","message":"Rate limit exceeded. Too many requests from this IP."}';
    ~*^/api/auth/login              '{"success":false,"code":"LOGIN_RATE_LIMITED","message":"로그인 요청이 많습니다. 잠시 후 다시 시도해주세요."}';
    ~*^/api/auth/mfa/               '{"success":false,"message":"인증 요청이 많습니다. 잠시 후 다시 시도해 주세요."}';
}

limit_req_zone $edge_login_limit_key zone=edge_login:10m rate=${EDGE_LOGIN_REQUESTS_PER_MINUTE}r/m;

server {
    listen 8080;
    server_name _;

    set_real_ip_from ${EDGE_TRUSTED_UPSTREAM};
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    # 백엔드 업로드 상한(FILE_UPLOAD_MAX_REQUEST_SIZE 기본 50MB)과 맞춘다. 여기서 먼저 막히면
    # 사용자는 백엔드의 필드 오류 대신 413 을 본다.
    client_max_body_size ${EDGE_CLIENT_MAX_BODY_SIZE};

    # compose 헬스체크 전용. 뒤 서비스의 준비 여부는 frontend 자신의 헬스체크가 판정한다.
    location = /__edge/health {
        access_log off;
        return 200;
    }

    # 로그인 요청 제한의 거부 응답(ADR-0059). 뒤 서비스가 보낸 429 는 여기로 오지 않는다(proxy_intercept_errors 꺼짐).
    location @edge_login_limited {
        default_type "application/json; charset=utf-8";
        add_header Cache-Control "no-store" always;
        add_header X-Rate-Limit-Retry-After-Seconds 60 always;
        return 429 $edge_login_limited_body;
    }

    location / {
        # 위 map 이 로그인 경로에만 키를 준다. 버스트는 한도와 같고 기다리게 하지 않는다(백엔드 토큰 버킷과 같은 꼴).
        limit_req zone=edge_login burst=${EDGE_LOGIN_REQUESTS_PER_MINUTE} nodelay;
        limit_req_status 429;
        limit_req_log_level warn;
        error_page 429 = @edge_login_limited;

        proxy_pass http://frontend:3000;
        proxy_http_version 1.1;

        # Next 의 Origin 검사(proxy.ts)는 Host 를 기준으로 판정한다 — 포트까지 원래 값을 넘긴다.
        proxy_set_header Host $http_host;
        # 덮어쓴다. `$proxy_add_x_forwarded_for` 로 이어 붙이면 클라이언트가 보낸 값이 앞에 남는다.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Host $http_host;
        # 표준 Forwarded 는 쓰지 않으므로 클라이언트 값을 넘기지 않는다. X-Forwarded-Proto 는 건드리지 않는다 — 이 서버는 평문이라
        # $scheme 이 늘 http 이고, 앞단이 TLS 를 끝낼 때 넘긴 https 를 덮으면 Next 의 출처 판정이 어긋난다.
        proxy_set_header Forwarded "";

        # /ws 는 Next rewrite 를 거쳐 백엔드 STOMP 로 간다.
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 300s;
    }
}
