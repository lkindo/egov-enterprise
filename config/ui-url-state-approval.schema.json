{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egov-enterprise/config/ui-url-state-approval.schema.json",
  "title": "URL-state 분류 승인 오버레이",
  "description": "config/ui-url-state-census.json 은 소스를 정적으로 훑어 기계 생성되므로 그 안에 승인을 쓸 수 없다(문법이 스스로를 승인하게 된다). 사람의 판단은 이 오버레이에만 존재한다. 설계 근거는 docs/02-architecture/url-state-approval-overlay-design.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "state", "authority", "schemaRef", "manifestRef", "classes"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "state": {
      "description": "오버레이 자신의 지위. 개별 class 의 reviewState 와 다르다.",
      "enum": ["proposed", "class-governed"]
    },
    "authority": { "const": "non-normative-url-state-class-registry" },
    "schemaRef": { "const": "config/ui-url-state-approval.schema.json" },
    "manifestRef": {
      "description": "어느 census 의 어느 버전에 대한 판단인지 결속한다. census 가 재생성되면 해시가 어긋나 red 가 되고, 승인이 낡은 생성물을 가리키지 못한다.",
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "const": "config/ui-url-state-census.json" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "classes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/class" }
    }
  },
  "$defs": {
    "class": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classId",
        "description",
        "selector",
        "reviewState",
        "dataClass",
        "privacyReview",
        "authorizationReview",
        "owner",
        "reviewBy",
        "approvals"
      ],
      "properties": {
        "classId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "decisionRef": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "selector": {
          "description": "이 class 가 덮는 stateItem 이름 집합. recordIds 가 있으면 해당 census record 안에서만 exact 매칭한다.",
          "type": "object",
          "additionalProperties": false,
          "required": ["stateItemNames"],
          "properties": {
            "stateItemNames": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "recordIds": {
              "description": "같은 query key 를 쓰는 새 route 가 묵시 승인되지 않도록 범위를 현재 census record 로 제한한다.",
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^URL-[A-F0-9]{14}$" }
            },
            "routeKeyBindings": {
              "description": "정적 census가 producer/key를 해소하지 못한 경로까지 포함하는 화면별 exact 계약이다.",
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["routePattern", "stateItemNames", "sources"],
                "properties": {
                  "routePattern": { "type": "string", "pattern": "^/" },
                  "stateItemNames": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": { "type": "string", "minLength": 1 }
                  },
                  "sources": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": { "type": "string", "pattern": "^(frontend|scripts)/" }
                  }
                }
              }
            }
          }
        },
        "reviewState": {
          "description": "blocked-input 은 사람이 판단할 수 없는 상태다(예: census 가 무엇인지 알아내지 못한 항목). approved 만이 만료 면제를 연다.",
          "enum": ["blocked-input", "proposed", "approved"]
        },
        "dataClass": {
          "description": "이 부류가 URL 에 싣는 값의 성격. unverified 는 아직 판정하지 않았다는 뜻이다.",
          "enum": [
            "unverified",
            "non-sensitive-presentation",
            "server-issued-identifier",
            "user-typed-free-text",
            "enumerated-control-flag",
            "indeterminate"
          ]
        },
        "privacyReview": { "enum": ["unverified", "verified", "accepted-risk", "not-applicable"] },
        "authorizationReview": { "enum": ["unverified", "verified", "not-applicable"] },
        "owner": { "type": "string", "minLength": 1 },
        "reviewBy": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "approvals": {
          "type": "object",
          "additionalProperties": false,
          "required": ["securityPrivacy", "domain"],
          "properties": {
            "securityPrivacy": { "$ref": "#/$defs/approvalOrNull" },
            "domain": { "$ref": "#/$defs/approvalOrNull" }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "anyOf": [
              {
                "properties": { "classId": { "const": "search-input" } },
                "required": ["classId"]
              },
              {
                "properties": { "dataClass": { "const": "user-typed-free-text" } },
                "required": ["dataClass"]
              }
            ]
          },
          "then": {
            "type": "object",
            "properties": {
              "classId": { "const": "search-input" },
              "decisionRef": { "const": "docs/02-architecture/decisions/ADR-0009-controlled-url-search-state.md" },
              "dataClass": { "const": "user-typed-free-text" },
              "selector": {
                "type": "object",
                "properties": {
                  "recordIds": { "type": "array" },
                  "routeKeyBindings": { "type": "array" }
                },
                "required": ["recordIds", "routeKeyBindings"]
              }
            },
            "required": ["classId", "decisionRef", "dataClass", "selector"]
          },
          "else": {
            "not": { "required": ["decisionRef"] }
          }
        }
      ]
    },
    "approvalOrNull": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/approval" }]
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer", "reviewedAt", "evidence"],
      "properties": {
        "reviewer": {
          "description": "명명된 사람 또는 책임 역할. 빈 문자열은 승인이 아니다.",
          "type": "string",
          "minLength": 1
        },
        "reviewedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "evidence": {
          "description": "근거 없는 승인을 막는다. 비어 있으면 승인으로 인정하지 않는다.",
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
