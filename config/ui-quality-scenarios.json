{
  "schemaVersion": 1,
  "asOf": "2026-08-21",
  "authority": "baseline-input-not-results",
  "protocol": "docs/04-operations/ui-ux-baseline-protocol.md",
  "routeTruthSource": "config/ui-route-capabilities.json",
  "artifactRoot": "build/reports/ui-quality-baseline",
  "caseIdentityFields": [
    "route",
    "role",
    "state",
    "brandTheme",
    "colorMode",
    "viewport"
  ],
  "unknownPolicy": {
    "allowedBoundedStatuses": [
      "unverified",
      "unmeasured",
      "blocked-external"
    ],
    "maxReviewDays": 90
  },
  "dimensions": {
    "brandThemes": [
      {
        "id": "current-default",
        "status": "unverified",
        "description": "현재 렌더 기본값을 식별하기 위한 baseline label이며 승인된 기관 브랜드 profile이 아니다.",
        "owner": "design-system + product/UX",
        "reviewBy": "2026-11-19"
      }
    ],
    "colorModes": [
      "light",
      "dark"
    ],
    "viewports": [
      {
        "id": "mobile-320",
        "width": 320,
        "height": 800
      },
      {
        "id": "tablet-768",
        "width": 768,
        "height": 1024
      },
      {
        "id": "desktop-1280",
        "width": 1280,
        "height": 800
      }
    ]
  },
  "repeatPolicy": {
    "cold": {
      "repetitions": 3,
      "browserContext": "new-context-per-repeat",
      "httpCache": "disabled",
      "precondition": "storage and application caches cleared; required synthetic auth state restored before navigation"
    },
    "warm": {
      "repetitions": 3,
      "browserContext": "same-context-after-one-unrecorded-prime",
      "httpCache": "enabled",
      "precondition": "same build, role, state, theme, color mode, viewport and synthetic dataset as cold run"
    },
    "summaryStatistics": [
      "median",
      "minimum",
      "maximum",
      "median-absolute-deviation"
    ]
  },
  "metrics": {
    "task": [
      {
        "id": "task-success",
        "unit": "categorical",
        "definition": "authoritative readback까지 unassisted-success, assisted-success, failed, invalid-attempt 중 하나로 판정"
      },
      {
        "id": "completion-time-ms",
        "unit": "milliseconds",
        "definition": "prompt 종료부터 authoritative readback까지의 monotonic elapsed time; 사전 기록한 진행자·환경 pause 제외"
      },
      {
        "id": "critical-error-count",
        "unit": "count",
        "definition": "권한 오부여, 데이터 손실·중복, 개인정보 노출, 잘못된 대상의 파괴적 변경 횟수"
      },
      {
        "id": "noncritical-error-count",
        "unit": "count",
        "definition": "과업을 즉시 파손하지 않지만 우회·재입력·오해를 만든 오류 횟수"
      },
      {
        "id": "assistance-count",
        "unit": "count",
        "definition": "진행자가 경로 또는 해결 정보를 제공한 횟수; 중립적 prompt 반복은 별도 기록"
      },
      {
        "id": "first-click-correct",
        "unit": "boolean",
        "definition": "과업 시작 후 첫 목적지 선택이 사전 정의한 유효 경로 집합에 포함되는지"
      },
      {
        "id": "recovery-success",
        "unit": "categorical",
        "definition": "주입한 오류 뒤 입력·focus·완료 상태를 보존해 unassisted, assisted, failed 중 하나로 판정"
      }
    ],
    "performance": [
      {
        "id": "route-js-transfer-bytes",
        "unit": "bytes",
        "definition": "해당 navigation의 same-origin script PerformanceResourceTiming transferSize 합과 개별 resource 목록"
      },
      {
        "id": "lcp-ms",
        "unit": "milliseconds",
        "definition": "buffered LargestContentfulPaint entry의 startTime; 관측 종료 시점과 실제 element를 함께 기록"
      },
      {
        "id": "lcp-element-resource",
        "unit": "structured",
        "definition": "LCP element의 닫힌 tag/role, size, resource same-origin 분류와 bounded redacted route template/category만 기록; raw URL/path/selector/filename은 제외"
      },
      {
        "id": "cls",
        "unit": "score",
        "definition": "hadRecentInput=false인 layout-shift entry의 누적값과 가장 큰 shift source의 redacted locator"
      },
      {
        "id": "interaction-latency-proxy-ms",
        "unit": "milliseconds",
        "definition": "지정 action 시작부터 observable state와 authoritative readback 후 안정 paint까지의 controlled proxy; field INP로 표현하지 않음"
      }
    ]
  },
  "automation": {
    "axe": {
      "runner": "@axe-core/playwright",
      "deterministic": true,
      "browserProject": "chromium",
      "locale": "ko-KR",
      "timezone": "Asia/Seoul",
      "animations": "disabled",
      "runOnlyTags": [
        "wcag2a",
        "wcag2aa",
        "wcag21a",
        "wcag21aa",
        "wcag22a",
        "wcag22aa"
      ],
      "requiredRules": [
        "color-contrast"
      ],
      "disabledRules": [],
      "readyContract": "scenario step의 heading, data fixture와 pending indicator 종료를 명시적으로 기다린 뒤 scan"
    },
    "limitations": [
      "axe는 현재 렌더된 DOM과 실행된 state만 검사하며 방문하지 않은 route, 가상화 밖 행, 닫힌 overlay와 미주입 오류를 증명하지 않는다.",
      "axe green은 keyboard task completion, 화면낭독기 발화 품질, focus 복귀, 콘텐츠 이해 또는 WCAG 2.2 준수를 증명하지 않는다.",
      "color-contrast rule은 활성화하지만 이미지·gradient·투명 합성·forced-colors와 모든 interaction state의 사람 검토를 대체하지 않는다."
    ]
  },
