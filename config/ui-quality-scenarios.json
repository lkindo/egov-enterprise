  "executionBlockers": [
    {
      "id": "baseline-runtime-evidence",
      "status": "unmeasured",
      "reason": "current authoritative r12는 exact 8개 scenario·96/96 state·48/48 performance를 invalid 0으로 완료했고, synthetic mutation task evidence 36건도 case-bound 실행·authoritative readback·rollback·cleanup·active residue 0으로 닫았다. r12 automated-only durable publication은 UA-04에서 완료됐지만 execution-captured protocol hash와 manual evidence 48건이 없어 8개 scenario 모두 partial-automated-evidence다.",
      "owner": "quality engineering",
      "reviewBy": "2026-11-19"
    },
    {
      "id": "baseline-artifact-durability",
      "status": "unmeasured",
      "reason": "r12 automated-only summary는 사람 redaction review 8/8을 거쳐 canonical digest e7822b6a31dcf9ff5e129238e42cce7be29d5f126554e8ea400cf249c69af8e4와 tracked index 첫 entry로 발행됐다. clean-checkout committed Git blob identity readback, PR #434 required CI와 merge commit f39ba9930df973710318088ccb00a2800643d9a3의 post-merge CI가 모두 통과해 UA-04 durable publication은 완료됐지만, r12는 execution-captured protocol hash와 manual evidence 부재로 measured 승격 대상이 아니다.",
      "owner": "quality engineering + repository governance",
      "reviewBy": "2026-11-19"
    },
    {
      "id": "manual-at-evidence",
      "status": "blocked-external",
      "reason": "r12 manual evidence 48건 중 40건은 전문가 검토가 필요하고 NVDA/Chrome 8건은 외부 차단 상태다. 실제 Windows 접근성 설정을 사용하는 지정 평가자, 격리 계정과 기록 승인 없이는 수동 결과를 만들 수 없다.",
      "owner": "accessibility owner",
      "reviewBy": "2026-11-19"
    }
  ],
