{
  "name": "egov-enterprise-root",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npx -y concurrently -n \"API,WEB\" -c \"blue,green\" \"gradlew.bat :api-server:bootRun -Dfile.encoding=UTF-8\" \"pnpm -C frontend dev\"",
    "backend": "gradlew :api-server:bootRun",
    "frontend": "pnpm -C frontend dev",
    "all": "npm run dev",
    "test": "npx cross-env TZ=Asia/Seoul gradlew test -Dfile.encoding=UTF-8",
    "test:ci": "npx cross-env TZ=Asia/Seoul gradlew test --continue -Dfile.encoding=UTF-8",
    "test:coverage": "npx cross-env TZ=Asia/Seoul gradlew test jacocoRootReport --continue -Dfile.encoding=UTF-8",
    "verify": "node scripts/verify.mjs all",
    "verify:be": "node scripts/verify.mjs be",
    "verify:fe": "node scripts/verify.mjs fe"
  },
  "dependencies": {
    "cross-env": "^7.0.3",
    "pg": "^8.20.0"
  }
}
