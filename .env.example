# ============================================================
# .env.example - 백엔드/로컬 부트스트랩 환경변수 템플릿
# 복제 대상: .env
# ------------------------------------------------------------
# 소비 주체:
#  - docker-compose: 루트 .env 를 변수치환(${JWT_SIGNING_KEYS_JSON} 등)에 사용.
#  - 로컬 백엔드(npm run dev = base 프로파일): application.yml 이 DB 접속 기본값을
#    docker-compose 와 동일(egov/egov123/egovdb:5432)하게 정의하므로 .env 없이도 접속된다.
#    (Spring 은 .env 를 직접 읽지 않는다 — dotenv 의존성 미사용. 아래 값은 참조/일치용 기본값이다.)
#    다른 DB 로 접속하려면 이 값들을 실제 환경변수로 export 하거나 프로파일을 지정한다.
# ============================================================

# (선택 1) 로컬 Docker DB 사용 시 (기본값)
DB_URL=jdbc:postgresql://localhost:5432/egovdb?currentSchema=public&prepareThreshold=0&sslmode=disable
DB_USERNAME=egov
DB_PASSWORD=egov123

# 다른 DB는 호스트·계정·비밀번호를 저장소에 적지 말고 실행 환경의 시크릿으로 주입한다.

# HikariCP (LegacyConfig 직접 바인딩이므로 spring.datasource의 flat 키로 소비됨)
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=2
DB_POOL_CONNECTION_TIMEOUT_MS=3000

# 파일 업로드 HTTP 상한(FileService의 10MiB/50MiB 선검증과 정합)
FILE_UPLOAD_MAX_SIZE=10MB
FILE_UPLOAD_MAX_REQUEST_SIZE=50MB

# ─────────────────────────────────────────────────────────────────────────────
# JWT 서명·검증 키링 (ADR-0060 — ES256 비대칭 서명. 2차 배포(2026-11-25)로 HMAC 서명 비밀 JWT_SECRET 은 걷었다)
#
# - 백엔드(api)만 개인키 키링(JWT_SIGNING_ACTIVE_KID·JWT_SIGNING_KEYS_JSON)을 받는다.
# - 프런트(frontend)는 공개키(JWT_VERIFY_KEYS_JSON, SPKI Base64)만 받으며 개인키를 받지 않는다.
# - 설정하지 않고 `npm run dev` 로 띄우면 저장소의 개발용 키쌍(dev-es256-1)을 쓰고, 백엔드는 127.0.0.1 에만 바인딩한다
#   (그 개인키는 공개돼 있어 루프백이 아닌 주소에서는 기동을 멈춘다 — docs/04-operations/crypto-key-rotation.md §8.4).
# ─────────────────────────────────────────────────────────────────────────────
# JWT_SIGNING_ACTIVE_KID=
# JWT_SIGNING_KEYS_JSON=
# JWT_VERIFY_KEYS_JSON=

# SMS 기본값은 비활성이다. 실제 연동 시 sens와 기관이 발급받은 시크릿·등록 발신번호를 주입한다.
# 접수(202)는 전달 완료가 아니며 결과가 불확실한 POST를 자동 재발송하지 않는다.
NURI_SMS_PROVIDER=none
NURI_SMS_SENS_SERVICE_ID=
NURI_SMS_SENS_ACCESS_KEY=
NURI_SMS_SENS_SECRET_KEY=
NURI_SMS_SENS_REGISTERED_SENDER=
NURI_SMS_CONNECT_TIMEOUT=3s
NURI_SMS_REQUEST_TIMEOUT=10s

# TOTP MFA (로컬/앱 기본값은 비활성. 운영 오버레이 docker-compose.prod.yml 은 MFA_REQUIRE_PROTECTED 기본값이 true 다 — ADR-0054)
# - scripts/deploy.sh 는 .env 를 읽지 않고 export 된 셸 환경변수만 소비한다.
# - docker compose -f docker-compose.yml -f docker-compose.prod.yml 을 직접 실행할 때 전환 유예가 필요하면 MFA_REQUIRE_PROTECTED=false 를 지정한다.
# MFA_ACTIVE_KEY_ID=
# MFA_KEYS_JSON=
# MFA_REQUIRE_PROTECTED=false
