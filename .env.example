# ============================================================
# .env.example - 백엔드/로컬 부트스트랩 환경변수 템플릿
# 복제 대상: .env
# ------------------------------------------------------------
# 소비 주체:
#  - docker-compose: 루트 .env 를 변수치환(${JWT_SECRET} 등)에 사용.
#  - 로컬 백엔드(npm run dev = base 프로파일): application.yml 이 DB 접속 기본값을
#    docker-compose 와 동일(egov/egov123/egovdb:5432)하게 정의하므로 .env 없이도 접속된다.
#    (Spring 은 .env 를 직접 읽지 않는다 — dotenv 의존성 미사용. 아래 값은 참조/일치용 기본값이다.)
#    다른 DB 로 접속하려면 이 값들을 실제 환경변수로 export 하거나 프로파일을 지정한다.
# ============================================================

# (선택 1) 로컬 Docker DB 사용 시 (기본값)
DB_URL=jdbc:postgresql://localhost:5432/egovdb?currentSchema=public&prepareThreshold=0&sslmode=disable
DB_USERNAME=egov
DB_PASSWORD=egov123

# 다른 DB는 호스트·계정·비밀번호를 저장소에 적지 말고 실행 환경의 시크릿으로 주입한다.

# HikariCP (LegacyConfig 직접 바인딩이므로 spring.datasource의 flat 키로 소비됨)
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_POOL_CONNECTION_TIMEOUT_MS=3000

# 파일 업로드 HTTP 상한(FileService의 10MiB/50MiB 선검증과 정합)
FILE_UPLOAD_MAX_SIZE=10MB
FILE_UPLOAD_MAX_REQUEST_SIZE=50MB

# ─────────────────────────────────────────────────────────────────────────────
# JWT 서명용 비밀키
#
# ⚠ 이 값은 **백엔드와 프론트 미들웨어 양쪽에 동일하게** 들어가야 한다.
#   한쪽만 받으면 백엔드는 A 로 서명하고 미들웨어는 B 로 검증해 서명 검증이 전량 실패한다.
#   그 실패는 조용하다 — 로그인 API 는 200 을 주고(미들웨어를 우회하는 경로다), 그 다음 페이지
#   진입에서 307 로 /login 에 되돌아가므로 "인증 완료 후 다시 로그인창" 무한 루프로만 보인다.
#   (2026-07-19 실제 발생. 원인 파악에 오래 걸렸다.)
#
# 그래서 기본값은 **주석 처리**다. 설정하지 않으면 백엔드(application.yml)와
# 미들웨어(frontend/src/middleware.ts)가 각자 **동일한** dev 기본값을 쓰므로 대칭이 보장된다.
#
# 굳이 설정하려면 `npm run dev` 로 함께 띄워라 — scripts/dev.mjs 가 루트 .env 를 로드해
# 두 프로세스에 같은 환경을 물려준다. 따로 띄우는 경우엔 양쪽 기동 로그의
# "JWT secret fingerprint"(sha256 앞 8자)가 일치하는지 눈으로 확인하라.
#
# 운영은 application-prod.yml 이 기본값 없이 ${JWT_SECRET} 을 요구하므로 반드시 주입해야 한다.
# ─────────────────────────────────────────────────────────────────────────────
# JWT_SECRET=여기에-충분히-긴-임의의-값
