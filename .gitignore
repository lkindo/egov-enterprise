# ==========================================
# eGovFrame / Java / Gradle / Next.js .gitignore
# ==========================================

# ----- OS & IDE -----
# Windows
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
._*

# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr

# VS Code
.vscode/
*.code-workspace
.history/

# Eclipse
.project
.classpath
.settings/
.metadata/
*.launch

# ----- Build & Dependencies -----
# Java / Gradle / Maven / Eclipse
build/
bin/
target/
.gradle/
.mvn/
vendor/
*.class
*.jar
*.war
*.ear
*.zip
*.tar.gz

# Eclipse IDE
.factorypath

# Generated Sources (QueryDSL, Lombok, etc.)
**/generated-sources/
**/apt-generated/

# Node.js
**/node_modules/
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Next.js
**/.next/
dist/
export/

# Package locks (choose one: pnpm-lock.yaml is preferred)
package-lock.json
yarn.lock

# Legacy binary files
*.xlsx
*.xls
*.doc
*.docx
*.ppt
*.pptx

# ----- Environment & Secrets -----
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local
application-local.properties
application-local.yml

# ----- Logs & Temp Files -----
*.log
logs/
*_log.txt
*.txt
!README.md
!MENU_STRUCTURE.md
!PRD.MD
!TRD.MD
!LLD.MD
!COMPLIANCE_REPORT.md
!MIGRATION_PLAN.md
!MIGRATION_STRATEGY.md
!tasks.md
!task.md
!deps.txt
!jsp_keys.txt
boot_error*
server_run_*.txt

# Temp files
temp_*/
tmp_*/
*.tmp
*.temp
*.bak
*.swp
*~
*.orig

# ----- Tools & Infrastructure -----
# Docker
docker-data/

# Tomcat
apache-tomcat-*/
tomcat/

# Prisma
/prisma/migrations/
/prisma/dev.db
/prisma/dev.db-journal

# Playwright / Testing
test-output/
surefire-reports/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# ----- AI Tools -----
.jules/
.sisyphus/
.agent/
.gemini/

# ----- Upload/Storage -----
upload/
uploads/
files/
storage/

# ----- Project Specific -----
# Encoding conversion scripts (one-time use)
convert-*.py
encoding-logs/

# Template duplicates (use config-templates instead)
utf8-project-template/
