# ==========================================
# eGovFrame / Java / Gradle / Next.js .gitignore
# Optimized Version 2.0
# ==========================================

# ----- OS & IDE -----
**/Thumbs.db
**/Desktop.ini
**/$RECYCLE.BIN/
**/.DS_Store
**/.AppleDouble
**/._*
**/.idea/
**/*.iml
**/*.iws
**/*.ipr
**/.vscode/
**/*.code-workspace
**/.history/
**/.project
**/.classpath
**/.settings/
**/.metadata/
**/*.launch

# ----- Build & Dependencies -----
**/build/
**/bin/
**/target/
**/.gradle/
**/.mvn/
**/vendor/
**/*.class
**/*.jar
# Gradle wrapper jar은 반드시 VCS에 포함되어야 ./gradlew 부트스트랩이 가능하다 (GEMINI.md §0.6 컴파일 게이트)
!gradle/wrapper/gradle-wrapper.jar
**/*.war
**/*.ear
**/*.zip
**/*.tar.gz
**/.factorypath
**/generated-sources/
**/apt-generated/
**/src/main/generated/
**/node_modules/
**/.npm/
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*
**/.next/
**/dist/
**/export/
**/storybook-static/
**/playwright/.auth/
**/playwright-reports/

# ----- Lock Files (pnpm is the single standard) -----
# pnpm-lock.yaml     - Committed (primary, SSOT)
# npm/yarn lockfiles are ignored to prevent dual-lockfile drift (2026-07-11)
**/package-lock.json
**/yarn.lock

# ----- Office Documents (Binary) -----
*.xlsx
*.xls
*.doc
*.docx
*.ppt
*.pptx
*.pdf
*.hwp
*.hwpx

# ----- Local Configuration & Secrets -----
**/egovProps/conf/
**/*.local.properties
**/.env
**/.env*.local
**/.env.development.local
**/.env.test.local
**/.env.production.local
**/application-local.properties
**/application-local.yml
**/application-dev.properties
**/application-dev.yml
**/application-prod.properties
**/application-prod.yml

# ----- Logs & Temp Files -----
**/*.log
**/logs/
!**/src/**/logs/
**/*_log.txt
**/*_output.txt
**/boot_error*
**/server_run_*.txt
**/temp_*/
**/tmp_*/
**/*.tmp
**/*.temp
**/*.bak
**/*.swp
**/*~
**/*.orig
**/auth_error.txt
**/build_output*.txt
**/tests_output.txt
**/tests_debug.txt
**/coverage_output.txt
**/dependency-analysis*.txt
**/LOG_FILE_IS_UNDEFINED*
**/LOG_PATH_IS_UNDEFINED*

# ----- Tools & Infrastructure -----
**/docker-data/
**/apache-tomcat-*/
**/tomcat/
**/prisma/migrations/
**/prisma/dev.db
**/prisma/dev.db-journal
**/test-output/
**/surefire-reports/
**/test-results/
**/playwright-report/
**/blob-report/
**/playwright-screenshots/
**/playwright/.cache/
**/.playwright/
**/jacoco/
**/*.exec
**/coverage/
**/coverage-report/
**/out/
**/.vercel/
**/.turbo/
**/.server/
**/.prisma/

# -- Custom Tools & Binaries --
**/tools/k6/
**/*.exe
**/*.zip
**/*.msi

# ----- Java Tools (JRebel, etc.) -----
**/rebel.xml
**/*.rebel.xml.bak

# ----- AI Tools -----
**/.jules/
**/.sisyphus/
!**/.agent/
.agent/logs/
.agent/temp/
!**/.agent/knowledge/
!**/.agent/skills/
!**/.agent/workflows/
!**/.agent/scripts/
!**/.agent/mcp-servers/
**/.gemini/*
!**/.gemini/tasks/
!**/.claude/settings.json

# ----- Upload/Storage -----
**/upload/
**/uploads/
**/files/
# storage/ - Active project directory

# ----- Project Specific -----
**/convert-*.py
**/encoding-logs/
**/utf8-project-template/
**/check_db_menus.py
**/check_menus.py
**/fix_menus.py
**/fix_networkidle.ps1
**/restore-non-session-files.ps1

# ----- Deleted Legacy Modules (prevent re-creation) -----
# These modules were integrated into foundation/business-suite (2026-03)
common-core/
common-security/
module-core-iam/
module-system-admin/
module-workspace/
module-operation/
module-knowledge/

# ----- Git Worktrees -----
.worktrees/

# ----- Analysis & Reports -----
**/analysis/
**/lighthouse-reports/
**/bundle-analysis/
**/next-build-cache/

# ----- Storybook -----
**/storybook-static/
**/.storybook-generated/

# ----- Lighthouse CI -----
**/.lighthouseci/
**/lhci-reports/

# ----- Security -----
**/.snyk



# Database Dumps
database/dumps/

# 개인키/시크릿 — 리포지토리 커밋 금지 (2026-07-11 보안)
*.key
*.pem

# graphify cache
**/graphify-out/

# ----- 에이전트 세션 산출물 (저장소 자산 아님) -----
# 오케스트레이터/서브에이전트 작업 상태. 이중 오퍼레이터 환경에서 타 세션 상태가
# `git add -A` 로 혼입되는 것을 막는다.
.agents/

# 일회성 a11y 감사 스캔 스크립트·리포트 (재발 방지는 eslint jsx-a11y 규칙이 담당)
frontend/a11y_report.json
frontend/fast_a11y_report.json
frontend/unlabelled_buttons.json
frontend/check-a11y.mjs
frontend/find-all-a11y.mjs
frontend/scan-components.mjs
