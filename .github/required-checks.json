{
  "version": 1,
  "branch": "main",
  "workflow": ".github/workflows/ci.yml",
  "integrationId": 15368,
  "pullRequestPolicy": {
    "requiredApprovingReviewCount": 0,
    "requireCodeOwnerReview": false,
    "requireLastPushApproval": false,
    "dismissStaleReviewsOnPush": false,
    "requiredReviewThreadResolution": false
  },
  "criticalSteps": [
    {
      "jobId": "secret-scan",
      "name": "Run gitleaks (working tree + incremental)",
      "run": "set -euo pipefail\nVERSION=8.28.0\ncurl -sSL \"https://github.com/gitleaks/gitleaks/releases/download/v${VERSION}/gitleaks_${VERSION}_linux_x64.tar.gz\" \\\n  | tar -xz gitleaks\n\necho \"::group::① 워킹트리 스캔\"\n./gitleaks detect --source . --no-git --no-banner --redact --verbose \\\n  --report-format json --report-path gitleaks-worktree.json --exit-code 1\necho \"::endgroup::\"\n\n# 비교 기준: PR 이면 base, push 면 이전 HEAD. 둘 다 없으면(초회 푸시·수동 실행) 워킹트리 스캔으로 충분하다.\nBASE=\"\"\nif [ -n \"${{ github.event.pull_request.base.sha }}\" ]; then\n  BASE=\"${{ github.event.pull_request.base.sha }}\"\nelif [ -n \"${{ github.event.before }}\" ] && git cat-file -e \"${{ github.event.before }}^{commit}\" 2>/dev/null; then\n  BASE=\"${{ github.event.before }}\"\nfi\n\nif [ -z \"$BASE\" ]; then\n  echo \"ℹ️ 비교 기준 커밋이 없어 증분 스캔을 생략합니다(워킹트리 스캔은 이미 통과).\"\n  exit 0\nfi\n\necho \"::group::② 증분 스캔 ($BASE..${{ github.sha }})\"\n./gitleaks detect --source . --no-banner --redact --verbose \\\n  --log-opts=\"$BASE..${{ github.sha }}\" \\\n  --report-format json --report-path gitleaks-incremental.json --exit-code 1\necho \"::endgroup::\""
    },
    {
      "jobId": "secret-scan",
      "name": "Require complete dependency snapshots",
      "run": "node scripts/dependency-snapshot-readiness.mjs",
      "if": "github.event_name == 'pull_request' && (needs.change-scope.outputs.backend == 'true' || needs.change-scope.outputs.frontend == 'true')",
      "env": {
        "GITHUB_TOKEN": "${{ github.token }}",
        "BASE_SHA": "${{ github.event.pull_request.base.sha }}",
        "HEAD_SHA": "${{ github.event.pull_request.head.sha }}",
        "SNAPSHOT_WAIT_SECONDS": "600"
      }
    },
    {
      "jobId": "secret-scan",
      "name": "Block newly introduced high-risk runtime dependencies",
      "uses": "actions/dependency-review-action@a1d282b36b6f3519aa1f3fc636f609c47dddb294",
      "if": "github.event_name == 'pull_request' && (needs.change-scope.outputs.backend == 'true' || needs.change-scope.outputs.frontend == 'true')"
    },
    {
      "jobId": "frontend-scope",
      "name": "Frontend dependency audit policy",
      "run": "node ../scripts/frontend-audit-policy.mjs"
    }
  ],
  "requiredChecks": [
    {
      "context": "backend-build",
      "jobId": "backend-build",
      "needs": [
        "change-scope",
        "backend-scope"
      ],
      "jobIf": "always()",
      "aggregate": {
        "sourceJobId": "backend-scope",
        "sourceNeeds": [
          "change-scope"
        ],
        "sourceJobIf": "needs.change-scope.outputs.backend == 'true'",
        "sourceStepName": "Build and Test with Gradle",
        "sourceRun": "set -o pipefail\n./gradlew build jacocoRootCoverageVerification check -Dopenapi.export.path=api-docs.json --warning-mode fail --console=plain 2>&1 | tee /tmp/build-and-test.log",
        "sourceWorkingDirectory": null,
        "sourceEnv": {},
        "aggregateStepName": "백엔드 범위 결과 집계",
        "aggregateRun": "node scripts/aggregate-required-check.mjs",
        "resultExpression": "needs.backend-scope.result",
        "successResult": "success",
        "scopeExpression": "needs.change-scope.outputs.backend",
        "classifierResultExpression": "needs.change-scope.result",
        "skippedResult": "skipped"
      }
    },
    {
      "context": "frontend-build",
      "jobId": "frontend-build",
      "needs": [
        "change-scope",
        "frontend-scope"
      ],
      "jobIf": "always()",
      "aggregate": {
        "sourceJobId": "frontend-scope",
        "sourceNeeds": [
          "change-scope"
        ],
        "sourceJobIf": "needs.change-scope.outputs.frontend == 'true'",
        "sourceStepName": "Build and Test",
        "sourceRun": "set -o pipefail\npnpm run build 2>&1 | tee /tmp/fe-build.log\npnpm run bundle:check\npnpm run test:coverage 2>&1 | tee /tmp/fe-test.log",
        "sourceWorkingDirectory": "frontend",
        "sourceEnv": {},
        "aggregateStepName": "프론트엔드 범위 결과 집계",
        "aggregateRun": "node scripts/aggregate-required-check.mjs",
        "resultExpression": "needs.frontend-scope.result",
        "successResult": "success",
        "scopeExpression": "needs.change-scope.outputs.frontend",
        "classifierResultExpression": "needs.change-scope.result",
        "skippedResult": "skipped"
      }
    },
    {
      "context": "secret-scan",
      "jobId": "secret-scan",
      "needs": [
        "change-scope"
      ],
      "jobIf": "always()"
    },
    {
      "context": "e2e-test",
      "jobId": "e2e-test",
      "needs": [
        "change-scope",
        "e2e-tests"
      ],
      "jobIf": "always()",
      "aggregate": {
        "sourceJobId": "e2e-tests",
        "sourceNeeds": [
          "change-scope",
          "backend-scope",
          "frontend-scope"
        ],
        "sourceJobIf": "always() && needs.change-scope.result == 'success' && needs.change-scope.outputs.e2e == 'true' && (needs.backend-scope.result == 'success' || needs.backend-scope.result == 'skipped') && (needs.frontend-scope.result == 'success' || needs.frontend-scope.result == 'skipped')",
        "sourceMatrix": {
          "key": "shard",
          "values": [
            "1/2",
            "2/2"
          ],
          "completeCoordinates": true
        },
        "sourceStepName": "Run E2E Tests (Sharded)",
        "sourceRun": "set -o pipefail\nmapfile -t E2E_SPECS < <(node ../scripts/e2e-shard-plan.mjs --shard \"${{ matrix.shard }}\")\nif [ \"${#E2E_SPECS[@]}\" -eq 0 ]; then\n  echo \"::error::Duration-balanced E2E plan returned no specs for shard ${{ matrix.shard }}\"\n  exit 1\nfi\nprintf 'E2E shard %s specs:\\n' \"${{ matrix.shard }}\"\nprintf '  %s\\n' \"${E2E_SPECS[@]}\"\nnpx playwright test --project=full-suite \"${E2E_SPECS[@]}\" --reporter=blob,line,json 2>&1 | tee /tmp/e2e-run.log\nnode ../scripts/playwright-result-contract.mjs --report \"$PLAYWRIGHT_JSON_OUTPUT_FILE\" \"${E2E_SPECS[@]}\"",
        "sourceWorkingDirectory": "frontend",
        "sourceEnv": {
          "CI": "true",
          "NEXT_PUBLIC_API_URL": "http://localhost:8080/api/v1",
          "PLAYWRIGHT_BROWSERS_PATH": "${{ env.PLAYWRIGHT_BROWSERS_PATH }}",
          "PLAYWRIGHT_JSON_OUTPUT_FILE": "/tmp/e2e-results.json"
        },
        "aggregateStepName": "E2E 샤드 결과 집계",
        "aggregateRun": "node scripts/aggregate-required-check.mjs",
        "resultExpression": "needs.e2e-tests.result",
        "successResult": "success",
        "scopeExpression": "needs.change-scope.outputs.e2e",
        "classifierResultExpression": "needs.change-scope.result",
        "skippedResult": "skipped"
      }
    },
    {
      "context": "mutation-test",
      "jobId": "mutation-test",
      "needs": [
        "change-scope",
        "mutation-scope"
      ],
      "jobIf": "always()",
      "aggregate": {
        "sourceJobId": "mutation-scope",
        "sourceNeeds": [
          "change-scope",
          "backend-scope"
        ],
        "sourceJobIf": "always() && needs.change-scope.result == 'success' && needs.change-scope.outputs.mutation == 'true' && needs.backend-scope.result == 'success'",
        "sourceStepName": "Incremental Mutation Test (${{ matrix.scope }})",
        "sourceRun": "./gradlew ${{ matrix.gradle }} --warning-mode fail --console=plain",
        "sourceWorkingDirectory": null,
        "sourceEnv": {
          "PIT_TARGET_CLASSES": "${{ matrix.classes }}",
          "PIT_TARGET_TESTS": "${{ matrix.tests }}",
          "STRICT_MUTATION": "true"
        },
        "aggregateStepName": "뮤테이션 스코프 결과 집계",
        "aggregateRun": "node scripts/aggregate-required-check.mjs",
        "resultExpression": "needs.mutation-scope.result",
        "successResult": "success",
        "scopeExpression": "needs.change-scope.outputs.mutation",
        "classifierResultExpression": "needs.change-scope.result",
        "skippedResult": "skipped"
      }
    }
  ]
}
