<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

	<!-- ?ㅽ듃?뚰겕?쒕퉬?ㅻえ?덊꽣留?  -->
	<bean id="ntwrkSvcMntrng" class="org.springframework.scheduling.quartz.MethodInvokingJobDetailFactoryBean">
		<property name="targetObject" ref="egovNtwrkSvcMntrngScheduling" />
		<property name="targetMethod" value="monitorNtwrkSvc" />
		<property name="concurrent" value="false" />
	</bean>

	<!-- ?ㅽ듃?뚰겕?쒕퉬?ㅻえ?덊꽣留? ?몃━嫄?->
	<bean id="ntwrkSvcMntrngTrigger" class="org.springframework.scheduling.quartz.SimpleTriggerFactoryBean">
		<property name="jobDetail" ref="ntwrkSvcMntrng" />
		<property name="startDelay" value="60000" />
		<property name="repeatInterval" value="600000" />
	</bean>
	
	<!-- 紐⑤땲?곕쭅 ?ㅼ?以꾨윭 -->
	<bean id="mntrngScheduler" class="org.springframework.scheduling.quartz.SchedulerFactoryBean">
		<property name="triggers">
			<list>
                <ref bean="ntwrkSvcMntrngTrigger" />
			</list>
		</property>
	</bean>

</beans>
