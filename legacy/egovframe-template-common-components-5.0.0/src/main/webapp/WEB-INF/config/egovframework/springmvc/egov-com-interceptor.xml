<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:context="http://www.springframework.org/schema/context"
	xmlns:mvc="http://www.springframework.org/schema/mvc"
	xmlns:p="http://www.springframework.org/schema/p"
	xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd
		http://www.springframework.org/schema/context http://www.springframework.org/schema/context/spring-context.xsd
		http://www.springframework.org/schema/mvc http://www.springframework.org/schema/mvc/spring-mvc.xsd">
	<!-- ?몄뀡(Session) 諛⑹떇 ?몄쬆?쒖뿉留?AuthenticInterceptor ?숈옉  -->
	<beans profile="session">  
		<mvc:interceptors>
			<!-- ?몄뀡諛⑹떇 ?묎렐?쒖뼱 ?명꽣?됲꽣 ?깅줉 -->
			<bean class="org.egovframe.rte.fdl.access.interceptor.EgovAccessInterceptor">
				<constructor-arg ref="egovAccessConfig" />
			</bean>
			<!-- IP ?뺣낫 湲곕줉 ?명꽣?됲꽣瑜??깅줉?쒕떎. -->
			<bean class="egovframework.com.cmm.interceptor.IpObtainInterceptor" />
		</mvc:interceptors>
	</beans>

	<!-- ?몄뀡(Session) 諛⑹떇 ?몄쬆?쒖뿉留?AuthenticInterceptor ?숈옉  -->
	<!-- ?숈옉紐⑤뱶(?꾨줈?뚯씪紐? : dummy, session, security ex)<beans profile="session"/> -->
	<beans profile="dummy">
		<mvc:interceptors>
			<!--
			* 濡쒓렇??泥댄겕媛 ?꾩슂??URL怨?濡쒓렇???щ?瑜?泥댄겕?댁쨪 ?명꽣?됲꽣 ?깅줉?????媛꾨떒??湲곕뒫 ?덉떆?대떎.
			* ?ㅻТ???ъ슜???쒗걧由ы떚 媛꾩냼???쒕퉬???먮뒗 ?몄뀡紐⑤뱶 ?묎렐?쒖뼱瑜??ъ슜?쒕떎.
			-->
			<mvc:interceptor>
				<mvc:mapping path="/**/*.do" />
				<mvc:exclude-mapping path="/uat/uia/**" />
				<mvc:exclude-mapping path="/index.do" />
				<mvc:exclude-mapping path="/cmm/fms/getImage.do" /> <!-- 濡쒓렇?명솕硫댁씠誘몄? -->
				<mvc:exclude-mapping path="/uss/ion/bnr/getBannerImage.do" /> <!-- ?ы꽭?덉젣諛곕꼫 -->
				<mvc:exclude-mapping path="/EgovLeft.do" />
				<mvc:exclude-mapping path="/EgovContent.do" />
				<mvc:exclude-mapping path="/EgovTop.do" />
				<mvc:exclude-mapping path="/EgovBottom.do" />
				<mvc:exclude-mapping path="/EgovModal.do" />
				<bean class="egovframework.com.cmm.interceptor.AuthenticInterceptor">
				<!-- 愿由ъ옄 沅뚰븳 Ant style Pattern List -->			
					<property name="adminAuthPatternList">
						<list>
						<!-- 蹂댁븞 > 沅뚰븳愿由?-->
							<value>/sec/ram/*.do</value>
						</list>
					</property>
				</bean>
			</mvc:interceptor>
		</mvc:interceptors>
	</beans>

</beans>