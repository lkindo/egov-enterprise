{
  "mcpServers": {
    "auggie": {
      "type": "stdio",
      "command": "auggie",
      "args": [
        "--mcp",
        "--mcp-auto-workspace"
      ]
    },
    "grok-search": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "uvx",
        "--from",
        "git+https://github.com/GuDaStudio/GrokSearch@grok-with-tavily",
        "grok-search"
      ],
      "env": {
        "GROK_API_URL": "https://api.x.ai/v1",
        "GROK_API_KEY": "dummy"
      }
    },
    "gemini": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "uvx",
        "--from",
        "git+https://github.com/GuDaStudio/geminimcp.git",
        "geminimcp"
      ]
    },
    "codex": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "uvx",
        "--from",
        "git+https://github.com/GuDaStudio/codexmcp.git",
        "codexmcp"
      ]
    }
  }
}
